# MinIO Root Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API Database Settings (SurrealDB internal routing in Podman)
ConnectionStrings__SurrealDb=Server=http://surrealdb:8000;Namespace=thevinehub;Database=production;Username=root;Password=root

# API JWT Settings
JwtSettings__Key=replace_this_with_a_secure_key
JwtSettings__Issuer=TheVineHub
JwtSettings__Audience=TheVineHub
JwtSettings__DurationInMinutes=1440

# Default User (Initial Seed)
DefaultUser__Document=123456789
DefaultUser__Name=Default
DefaultUser__LastName=Admin
DefaultUser__Password=Admin123!

# Cloudflare Tunnel
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
