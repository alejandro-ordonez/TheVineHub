@using JMMinistry.Common.Dtos.Discipleship

@inject IStringLocalizer<UIStrings> translator;

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_title"
                          Label="@translator["Title"]"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Class="mb-2" />

            <MudTextField @bind-Value="_description"
                          Label="@translator["Description"]"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Class="mb-2" />

            <MudTextField @bind-Value="_categoryInput"
                          Label="@translator["Categories"]"
                          Variant="Variant.Outlined"
                          Placeholder="Type and press Enter"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Add"
                          OnAdornmentClick="AddCategory"
                          OnKeyDown="HandleCategoryKeyDown"
                          Class="mb-2" />

            @if (_categories.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var category in _categories)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 OnClose="() => RemoveCategory(category)">
                            @category
                        </MudChip>
                    }
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@translator["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_isValid)" OnClick="Submit">
            @translator["Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _categoryInput = string.Empty;
    private List<string> _categories = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Small
            };
            await MudDialog.SetOptionsAsync(options);
        }
    }

    private void AddCategory()
    {
        var trimmed = _categoryInput.Trim();
        if (!string.IsNullOrWhiteSpace(trimmed) && !_categories.Contains(trimmed))
        {
            _categories.Add(trimmed);
            _categoryInput = string.Empty;
        }
    }

    private void HandleCategoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCategory();
        }
    }

    private void RemoveCategory(string category) => _categories.Remove(category);

    private void Submit()
    {
        var dto = new CreateDiscipleshipNoteDto
        {
            Title = _title,
            Description = _description,
            Categories = _categories
        };

        MudDialog?.Close(DialogResult.Ok(dto));
    }

    private void Cancel() => MudDialog?.Cancel();
}
