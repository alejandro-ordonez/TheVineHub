@using JMMinistry.Common.Dtos.Discipleship
@using JMMinistry.Web.Store.DiscipleshipNotesUseCase
@using Fluxor
@using Fluxor.Blazor.Web.Components

@inherits FluxorComponent

@inject IState<DiscipleshipNotesState> State;

<MudDialog>
    <DialogContent>
        <div class="note-detail">
            <div class="note-header mb-4">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(Note.NoteStatus)" Variant="Variant.Filled">
                        @Note.NoteStatus
                    </MudChip>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Note.CreatedAt.ToString("d")</MudText>
                </div>

                @if (!string.IsNullOrWhiteSpace(Note.Description))
                {
                    <MudText Typo="Typo.body1" Class="mb-2">@Note.Description</MudText>
                }

                @if (Note.Categories.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var category in Note.Categories)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@category</MudChip>
                        }
                    </div>
                }
            </div>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">Entries</MudText>

            @if (State.Value.IsLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (CurrentEntries.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">
                    No entries yet. Add the first one below.
                </MudAlert>
            }
            else
            {
                <div class="entries-list mb-4">
                    @foreach (var entry in CurrentEntries)
                    {
                        <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.caption"><b>@entry.AuthorId</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Date.ToString("d")</MudText>
                            </div>
                            <div class="entry-content">@((MarkupString)entry.Content)</div>
                        </MudPaper>
                    }
                </div>
            }

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Add Entry</MudText>
            <MudTextField T="string" @bind-Value="_newContent" Label="Content" Lines="3" Variant="Variant.Outlined" Class="mb-2" />
            <div class="d-flex gap-2 align-end">
                <MudDatePicker @bind-Date="_newDate" Label="Date" Variant="Variant.Outlined" Style="max-width: 200px;" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleSubmit"
                           Disabled="@(string.IsNullOrWhiteSpace(_newContent) || State.Value.IsLoading)">
                    Add
                </MudButton>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public required DiscipleshipNoteDto Note { get; set; }

    [Parameter]
    public EventCallback<(string Content, DateTime Date)> OnEntrySubmit { get; set; }

    private IList<DiscipleshipNoteEntryDto> CurrentEntries =>
        State.Value.EntriesByNoteId.TryGetValue(Note.NoteId, out var e) ? e : [];

    private string _newContent = string.Empty;
    private DateTime? _newDate = DateTime.Today;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Medium
            };

            await MudDialog.SetOptionsAsync(options);
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_newContent)) return;

        await OnEntrySubmit.InvokeAsync((_newContent, _newDate ?? DateTime.Today));
        _newContent = string.Empty;
        _newDate = DateTime.Today;
    }

    private void Close() => MudDialog?.Cancel();

    private static Color GetStatusColor(NoteStatus status) => status switch
    {
        NoteStatus.New => Color.Info,
        NoteStatus.UnderRevision => Color.Warning,
        NoteStatus.Resolved => Color.Success,
        NoteStatus.Abandoned => Color.Error,
        _ => Color.Default
    };
}
