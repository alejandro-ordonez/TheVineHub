@using JMMinistry.Common
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Extensions

@inject IStringLocalizer<UIStrings> translator;
@inject NavigationManager navigationManager;
@inject IDialogService dialogService;

<MudPaper Style="padding: 0.5rem" Class="mud-ripple" 
onclick="@(() => HandleClick())">

    <div class="user-card">
        <MudAvatar Class="avatar-icon" Color="UtilExtensions.GetRandomColor()">
            @if (string.IsNullOrEmpty(User.Photo))
            {
                @User.Name[0]
            }

            else
            {
                <MudImage Src="@User.Photo"></MudImage>
            }
        </MudAvatar>

        <div class="user-details">
            <MudText Typo="Typo.subtitle1" Class="text-icon-centered">
                <MudIcon Icon="@User.Gender.GetGenderIcon()" Color="@User.Gender.GetGenderColor()" />
                @User.GetFirsNameAndLastName()
            </MudText>

            <MudText Typo="Typo.body2" Class="text-icon-centered">
                <MudIcon Icon="@Icons.Material.Filled.Church" Color="Color.Tertiary" />
                @translator[User.MinistryStatus?.ToString() ?? ""]
            </MudText>

            <MudLink Typo="Typo.body2" Underline="Underline.None" Class="text-icon-centered" Href="@($"http://api.whatsapp.com/send?phone=57{User.Phone}")">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                @User.Phone
            </MudLink>

        </div>

        @if(OnClick is not null || (OnClick?.HasDelegate ?? false))
        {
            <MudIcon Style="opacity: 0.4" Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
        }
    </div>
</MudPaper>



@code {

    [Parameter]
    public required PartialUserInfoDto User { get; set; }

    [Parameter]
    public EventCallback<UserEventArgs>? OnClick { get; set; }

    void HandleClick()
    {
        if (OnClick is null)
            return;

        OnClick?.InvokeAsync(new UserEventArgs { CellId = User.CellId ?? 0, Document = User.Document });
    }

}
