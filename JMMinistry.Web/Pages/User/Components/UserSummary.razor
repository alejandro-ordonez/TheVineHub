@using JMMinistry.Common
@using JMMinistry.Common.Dtos.User

@inject IStringLocalizer<UIStrings> translator;

<div class="user-info-card">
    <div>
        <MudImage Src="/images/user.png" Fluid="true" Style="max-height: 200px; min-width: 150px; margin: 0.5rem;" />
    </div>

    <div class="user-info">
        <MudText Class="mx-4"Typo="Typo.h4">@UserInfo.GetFirsNameAndLastName()</MudText>
        <MudText Class="mx-4"Typo="Typo.h5">@($"{UserInfo?.Profession} {UserInfo?.Profession}")</MudText>

        <MudDivider Style="margin: 1rem 0px"/>

        <div class="grid-details">
            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                <MudLink Typo="Typo.body1" Underline="Underline.None" Class="text-icon-centered mx-4" Href="@($"http://api.whatsapp.com/send?phone=57{UserInfo?.Phone}")">
                    @UserInfo?.Phone
                </MudLink>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Email" />
                <MudText Class="mx-4"Typo="Typo.body1">@UserInfo?.Email</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                <MudText Class="mx-4"Typo="Typo.body1">@UserInfo?.Birthday</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Cake" />
                <MudText Class="mx-4" Typo="Typo.body1">@translator["YearsOld", UserInfo?.Birthday is null ? "" : UserInfo.Birthday.Value.YearsElapsed()]</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" />
                <MudText Class="mx-4"Typo="Typo.body1">@(UserInfo?.City ?? translator["NotSet"])</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Pin" />
                <MudText Class="mx-4" Typo="Typo.body1">@(UserInfo?.Address ?? translator["NotSet"])</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" />
                <MudText Class="mx-4" Typo="Typo.body1">@(UserInfo?.Locality ?? translator["NotSet"])</MudText>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public UserInfoDto? UserInfo { get; set; }

    
}
