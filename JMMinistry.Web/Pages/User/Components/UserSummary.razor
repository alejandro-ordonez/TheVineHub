@using JMMinistry.Common
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api

@inject IStringLocalizer<UIStrings> translator;
@inject IUserApi userApi;

<div class="user-info-card">
    <div class="photo-container @(CanUploadPhoto && !_uploading ? "photo-editable" : "")">
        @if (!string.IsNullOrEmpty(UserInfo?.Photo))
        {
            <img src="@GetPhotoUrl()" class="profile-photo" />
        }
        else
        {
            <img src="/images/user.png" class="profile-photo" />
        }

        @if (CanUploadPhoto)
        {
            <label class="photo-overlay">
                <InputFile accept=".png,.jpg,.jpeg,.webp" OnChange="OnPhotoSelected" style="display:none" />
                <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" />
                <span>@translator["ChangePhoto"]</span>
            </label>

            @if (_uploading)
            {
                <div class="photo-progress">
                    <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Surface" />
                </div>
            }
        }
    </div>

    <div class="user-info">
        <MudText Typo="Typo.h4">@UserInfo.GetFirsNameAndLastName()</MudText>
        <MudText Typo="Typo.h5">@($"{UserInfo?.Profession} {UserInfo?.Occupation}")</MudText>

        <MudDivider Style="margin: 1rem 0px"/>

        <div class="grid-details">
            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Key" />
                <MudText Class="mx-4" Typo="Typo.body1">@UserInfo?.Document</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                <MudLink Typo="Typo.body1" Underline="Underline.None" Class="text-icon-centered mx-4" Href="@($"http://api.whatsapp.com/send?phone=57{UserInfo?.Phone}")">
                    @UserInfo?.Phone
                </MudLink>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Email" />
                <MudText Class="mx-4" Typo="Typo.body1">@UserInfo?.Email</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                <MudText Class="mx-4" Typo="Typo.body1">@UserInfo?.Birthday</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Cake" />
                <MudText Class="mx-4" Typo="Typo.body1">@translator["YearsOld", UserInfo?.Birthday is null ? "" : UserInfo.Birthday.Value.YearsElapsed()]</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" />
                <MudText Class="mx-4"Typo="Typo.body1">@(UserInfo?.City ?? translator["NotSet"])</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.Pin" />
                <MudText Class="mx-4" Typo="Typo.body1">@(UserInfo?.Address ?? translator["NotSet"])</MudText>
            </div>

            <div class="grid-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" />
                <MudText Class="mx-4" Typo="Typo.body1">@(UserInfo?.Locality ?? translator["NotSet"])</MudText>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public UserInfoDto? UserInfo { get; set; }

    [Parameter]
    public bool CanUploadPhoto { get; set; }

    [Parameter]
    public EventCallback<string> OnPhotoUploaded { get; set; }

    bool _uploading;

    string GetPhotoUrl() => userApi.GetPhotoUrl(UserInfo!.Photo!);

    async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (UserInfo is null) return;

        var file = e.File;

        _uploading = true;
        StateHasChanged();

        var response = await userApi.UploadPhotoAsync(UserInfo.Document, file);

        if (response?.Success == true && response.Data is not null)
        {
            UserInfo.Photo = response.Data;
            if (OnPhotoUploaded.HasDelegate)
                await OnPhotoUploaded.InvokeAsync(response.Data);
        }

        _uploading = false;
        StateHasChanged();
    }
}
