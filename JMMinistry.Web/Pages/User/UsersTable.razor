@using JMMinistry.Common.Dtos.User;

@inject IStringLocalizer<UIStrings> _translator;

<MudTable ServerData="UserLoad"
          Dense="true"
          Hover="true"
          T="PartialUserInfoDto"
          @ref="table"
          MultiSelection="Selectable"
          SelectedItems="Selected"
          OnRowClick="RowClicked">

    <ToolBarContent>
        <MudText Typo="Typo.h6">@_translator["Users"]</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortLabel="Document" T="PartialUserInfoDto">@_translator["Document"]</MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel SortLabel="Name" T="PartialUserInfoDto">@_translator["Name"]</MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel SortLabel="LastName" T="PartialUserInfoDto">@_translator["LastName"]</MudTableSortLabel>
        </MudTh>

        <MudTh>
            <MudTableSortLabel SortLabel="MinistryStatus" T="PartialUserInfoDto">@_translator["MinistryStatus"]</MudTableSortLabel>
        </MudTh>

        <MudTh>
           @_translator["Phone"]
        </MudTh>

        @if (AnyActions)
        {
            <MudTh>
                @_translator["Actions"]
            </MudTh>
        }
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Document">@context.Document</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Last Name">@context.LastName</MudTd>
        <MudTd DataLabel="MinistryStatus">@_translator[context.MinistryStatus?.ToString() ?? ""]</MudTd>
        <MudTd DataLabel="Phone">@context.Phone</MudTd>

            @if (AnyActions)
            {
                <MudTd>
                    <div class="actions">
                        @if (EditUser.HasDelegate)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           OnClick="() => EditUser.InvokeAsync(new UserEventArgs { CellId = context.CellId, Document = context.Document })" />
                        }

                        @if (DeleteUser.HasDelegate)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Warning" 
                                           OnClick="() => DeleteUser.InvokeAsync(new UserEventArgs { CellId = context.CellId, Document = context.Document })" />
                        }
                    </div>
                </MudTd>
            }
    </RowTemplate>

    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>

    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>

    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
