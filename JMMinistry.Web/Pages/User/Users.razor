@using JMMinistry.Common.Dtos.Common
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api
@using JMMinistry.Web.Pages.User.Components

@layout MainLayout

@attribute [Route(Routes.UserManagement)]

@attribute [Authorize(Roles = "Admin")]

@inject IUserApi userApi;
@inject IStringLocalizer<UIStrings> translator;


<PageTitle>
    @translator["Users"]
</PageTitle>

<h3>@translator["Users"]</h3>

<MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="ImportUsers" MaximumFileCount="1">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload">

            @if (IsBusy)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@translator["Processing"]</MudText>
            }
            else
            {
                <MudText>@translator["ImportUsers"]</MudText>
            }            
        </MudButton>
    </ActivatorContent>
</MudFileUpload>


<UsersTable @ref="usersTable" FetchUsers="FetchUsers">

</UsersTable>


@code {
    private bool IsBusy { get; set; } = false;

    UsersTable? usersTable;

    private async Task<PagedResponse<PartialUserInfoDto>> FetchUsers(TableState state, string searchString)
    {
        var criteria = new UsersSearchCriteria();

        criteria.Document = searchString;
        criteria.OrderByMember = state.SortLabel;
        criteria.OrderDirection = state.SortDirection.ToString();
        criteria.Page = state.Page;
        criteria.PageSize = state.PageSize;

        var results = await userApi.GetUserByCriteria(criteria);

        PagedResponse<PartialUserInfoDto> pagedResponse;

        if (!results?.Success ?? true)
            pagedResponse = new PagedResponse<PartialUserInfoDto>();

        else
            pagedResponse = results?.Data ?? new PagedResponse<PartialUserInfoDto>();

        return pagedResponse;
    }

    private async Task ImportUsers(IBrowserFile file)
    {
        IsBusy = true;
        await userApi.ImportUsers(file);
        
        if(usersTable != null)
            await usersTable.RefreshData();

        IsBusy = false;
    }
}
