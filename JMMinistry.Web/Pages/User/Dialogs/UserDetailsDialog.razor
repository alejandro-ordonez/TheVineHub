@using JMMinistry.Common.Dtos.User
@using JMMinistry.Common.Dtos.User.Enums
@using JMMinistry.Web.Api
@using JMMinistry.Web.Pages.User.Components

@inject IUserApi userApi;
@inject ISnackbar snackbar;
@inject IStringLocalizer<UIStrings> translator;

<Dialog Result="dialogResult"
        Color="Color.Primary"
        PrimaryButton="AccessFullDetails"
        PrimaryText="MoreInfo"
        MaxWidth="MaxWidth.Medium"
        SecondaryButton="ShowRemoveButton && AccessFullDetails"
        SecondaryText="Remove">

    <Content>
        <UserSummary UserInfo="User" />
    </Content>

</Dialog>


@code {

    [Parameter]
    public required string Document { get; set; }

    [Parameter]
    public bool ShowRemoveButton { get; set; } = true;

    UserInfoDto? User { get; set; }

    bool AccessFullDetails = false;

    UserEventArgs? dialogResult;

    private static readonly AccessType[] AllowedAccessTypes = [AccessType.Admin, AccessType.Leader];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var response = await userApi.GetUserInfo(Document);

            if (response is not null && response.Success)
            {
                User = response.Data;
                AccessFullDetails = AllowedAccessTypes.Contains(User?.AccessType ?? AccessType.Mate)
                    && (User?.CellId ?? 0) != 0;
            }

            else
                snackbar.Add(translator["ErrorFetching"]);

            dialogResult = new UserEventArgs
            {
                Document = User?.Document ?? string.Empty,
                CellId = User?.CellId ?? 0
            };

            StateHasChanged();
        }
    }
}
