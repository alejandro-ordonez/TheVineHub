@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Pages.User.Forms
@inject IStringLocalizer<UIStrings> translator;

<Dialog Result="UserCreated"
        Color="Color.Primary"
        PrimaryButton="false"
        PrimaryText="@translator["Add"]">
    <Content>
        <UserForm @ref="_userForm" UserInfo="UserCreated" OnCompleted="OnFormCompleted" />
    </Content>
</Dialog>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [SupplyParameterFromForm]
    CreateUserInfoDto UserCreated { get; set; } = new();

    UserForm? _userForm;

    private void OnFormCompleted(CreateUserInfoDto user)
    {
        MudDialog?.Close(new DialogResult<AddUserResult>
        {
            Option = DialogResultOption.PrimaryButton,
            Data = new AddUserResult(user, _userForm?.TempPhotoId)
        });
    }

    public record AddUserResult(CreateUserInfoDto User, string? TempPhotoId);
}
