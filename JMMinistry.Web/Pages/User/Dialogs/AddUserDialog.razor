@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Pages.User.Forms
@inject IStringLocalizer<UIStrings> translator;

<Dialog Result="UserCreated"
        Color="Color.Primary"
        PrimaryButton="false"
        PrimaryText="@translator["Add"]">
    <Content>
        <UserForm UserInfo="UserCreated" OnCompleted="OnFormCompleted" />
    </Content>
</Dialog>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [SupplyParameterFromForm]
    CreateUserInfoDto UserCreated { get; set; } = new();

    private void OnFormCompleted(CreateUserInfoDto user)
    {
        MudDialog?.Close(new DialogResult<CreateUserInfoDto>
        {
            Option = DialogResultOption.PrimaryButton,
            Data = user
        });
    }
}
