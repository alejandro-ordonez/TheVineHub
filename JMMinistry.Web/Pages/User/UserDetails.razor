@attribute [Route($"{Routes.UserManagement}/{{Document:string}}")]

@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api

@inject IUserApi userApi;
@inject ISnackbar snackbar;
@inject IStringLocalizer<UIStrings> translator;

<h3>UserDetails</h3>

@code {

    [Parameter]
    public string? Document { get; set; }

    UserInfoDto? User { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var response = await userApi.GetUserInfo(Document);

            if (response is not null && response.Success)
            {
                User = response.Data;
            }

            else
                snackbar.Add(translator["ErrorFetching"]);

            StateHasChanged();
        }
    }
}
