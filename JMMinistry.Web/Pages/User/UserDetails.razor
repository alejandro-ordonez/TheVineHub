@attribute [Route($"{Routes.User}/{{Document?}}")]

@layout MainLayout

@using JMMinistry.Common
@using JMMinistry.Common.Dtos.Common
@using JMMinistry.Common.Dtos.Discipleship
@using JMMinistry.Web.Pages.User.Components
@using JMMinistry.Web.Pages.User.Discipleship
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api
@using JMMinistry.Web.Store.DiscipleshipNotesUseCase
@using JMMinistry.Web.Store.DiscipleshipNotesUseCase.Actions
@using Fluxor
@using Fluxor.Blazor.Web.Components

@inherits FluxorComponent

@inject IUserApi userApi;
@inject IMinistryApi ministryApi;
@inject ISnackbar snackbar;
@inject IStringLocalizer<UIStrings> translator;
@inject NavigationManager navigationManager;
@inject IState<DiscipleshipNotesState> DiscipleshipNotesState;
@inject IDispatcher Dispatcher;
@inject IDialogService dialogService;

<UserSummary UserInfo="User"/>

@if(User is not null)
{
    <MudTabs>

        @if(DiscipleshipNotesState.Value.IsLeader)
        {
            <MudTabPanel Text="@translator["DiscipleshipJournal"]" Icon="@Icons.Material.Filled.Book">
                <KanbanBoard Notes="DiscipleshipNotesState.Value.Notes"
                             IsLoading="DiscipleshipNotesState.Value.IsLoading"
                             OnNoteClicked="HandleNoteClicked"
                             OnCreateNote="HandleCreateNote" />
            </MudTabPanel>
        }

        <MudTabPanel Text="@translator["CellMates"]" Icon="@Icons.Material.Filled.Group">

            <div class="cards-grid">
                @foreach (var disciple in CellMates)
                {
                    <UserCard User="disciple"
                              OnClick="@(User.AccessType.IsAdminOrLeader() ? EventCallback.Factory.Create<UserEventArgs>(this, ShowUserDetails) :
                                                                  (EventCallback<UserEventArgs>?)null)" />
                        }
            </div>
        </MudTabPanel>

    </MudTabs>
}

@code {

    [Parameter]
    public string? Document { get; set; }

    UserInfoDto? User { get; set; }

    IList<PartialUserInfoDto> CellMates = [];

    protected override async Task OnParametersSetAsync()
    {
        var response = await userApi.GetUserInfo(Document);

        if (response is not null && response.Success)
        {
            User = response.Data;

            if (User?.CellId is not null && User?.CellId > 0)
                CellMates = await FetchCellMates(User.CellId.Value, User.Document);

            if (!string.IsNullOrEmpty(Document))
            {
                Dispatcher.Dispatch(new CheckIsLeaderAction { DiscipleId = Document });
                Dispatcher.Dispatch(new FetchDiscipleshipNotesAction { DiscipleId = Document });
            }
        }

        else
            snackbar.Add(translator["ErrorFetching"]);

        StateHasChanged();
    }

    async Task<IList<PartialUserInfoDto>> FetchCellMates(int cellId, string document)
    {
        var result = await ministryApi.GetDisciples(cellId);

        return result?.Data?.Where(user => user.Document != document).ToList() ?? [];
    }

    private EventCallback<UserEventArgs> GetClickHandler()
    {
        if (User is null || !User.AccessType.IsAdminOrLeader())
            return new EventCallback<UserEventArgs>(null, null);

        return EventCallback.Factory.Create<UserEventArgs>(this, ShowUserDetails);
    }


    void ShowUserDetails(UserEventArgs user)
    {
        navigationManager.NavigateTo($"{Routes.User}/{user.Document}");
    }

    async Task HandleCreateNote()
    {
        if (string.IsNullOrEmpty(Document)) return;

        var dialog = await dialogService.ShowAsync<CreateNoteDialog>(translator["DiscipleshipJournal"]);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var dto = result.Data as CreateDiscipleshipNoteDto;
        if (dto is null) return;

        Dispatcher.Dispatch(new CreateNoteAction
        {
            DiscipleId = Document,
            Title = dto.Title,
            Description = dto.Description,
            Categories = dto.Categories
        });
    }

    async Task HandleNoteClicked(int noteId)
    {
        var note = DiscipleshipNotesState.Value.Notes.FirstOrDefault(n => n.NoteId == noteId);
        if (note is null || string.IsNullOrEmpty(Document)) return;

        Dispatcher.Dispatch(new SelectNoteAction { NoteId = noteId });
        Dispatcher.Dispatch(new FetchNoteEntriesAction { DiscipleId = Document, NoteId = noteId });

        var parameters = new DialogParameters<NoteDetailDialog>
        {
            { x => x.Note, note },
            { x => x.OnEntrySubmit, EventCallback.Factory.Create<(string Content, DateTime Date)>(this, entry => HandleEntrySubmit(noteId, entry)) }
        };

        await dialogService.ShowAsync<NoteDetailDialog>(note.Title, parameters);

        Dispatcher.Dispatch(new SelectNoteAction { NoteId = null });
    }

    void HandleEntrySubmit(int noteId, (string Content, DateTime Date) entry)
    {
        if (string.IsNullOrEmpty(Document)) return;

        Dispatcher.Dispatch(new CreateNoteEntryAction
        {
            DiscipleId = Document,
            NoteId = noteId,
            Content = entry.Content,
            Date = entry.Date
        });
    }
}
