@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api
@using JMMinistry.Web.Services
@using JMMinistry.Web.Layout

@inject IAuthService authService
@inject IStringLocalizer<UIStrings> Loc
@inject NavigationManager navigation

@page "/auth"
@layout EmptyLayout

<div class="login-container">
    <section class="column login-section">
        <MudCard Style="flex-grow: 1;">
            <MudForm Model="Model" @ref="form" Validation="AuthValidator.ValidateValue" ValidationDelay="3">

                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h2">@Loc["Welcome"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudTextField @bind-Value="Model!.Document"
                                  For="@(() => Model!.Document)"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="@Loc["FieldRequired"]"
                                  Variant="Variant.Outlined"
                                  Label="@Loc["Document"]" 
                                  InputType="InputType.Number"/>

                    <MudTextField @bind-Value="Model!.Password"
                                  For="@(() => Model!.Password)"
                                  Immediate="true"
                                  Required="true"
                                  OnlyValidateIfDirty="true"
                                  RequiredError="@Loc["FieldRequired"]"
                                  Variant="Variant.Outlined"
                                  Label="@Loc["Password"]" 
                                  InputType="InputType.Password"/>

                </MudCardContent>

                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               OnClick="@(async () => await Submit())">
                               

                        @if (Busy)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>@Loc["LogIn"]</MudText>
                        }
                    </MudButton>
                </MudCardActions>
            </MudForm>
        </MudCard>
    </section>

    <section class="column side-section">

    </section>
</div>

@code {

    [SupplyParameterFromForm]
    public AuthenticateDto? Model { get; set; }

    public AuthenticateValidator AuthValidator = new AuthenticateValidator();

    [Inject] 
    ISnackbar? SnackBar { get; set; }

    MudForm? form;

    bool Busy { get; set; } = false;

    protected override void OnInitialized()
    {
        Model ??= new AuthenticateDto();
    }

    private async Task Submit()
    {
        Busy = true;
        form?.Validate();

        if(!form?.IsValid ?? false)
        {
            SnackBar?.Add(Loc["VerifyYourInputs"], Severity.Error);
            return;
        }

        var result = await authService.LogIn(Model!);

        if (result)
        {
            navigation.NavigateTo("/");
            SnackBar?.Add(Loc["AuthenticationSuccess"], Severity.Success);
        }

        else
            SnackBar?.Add(Loc["AuthenticationFailed"], Severity.Error);

        Busy = false;
    }
}
