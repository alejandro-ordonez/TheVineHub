@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api
@using JMMinistry.Web.Services
@using JMMinistry.Web.Layout

@inject IAuthService authService
@inject IStringLocalizer<UIStrings> _translator;
@inject NavigationManager navigation

@page "/auth"
@layout EmptyLayout

<div class="page-container">
    <section class="column content-section login-form-card">
        <MudCard Style="width: 100%">
            <MudForm Model="Model" @ref="form" Validation="AuthValidator.ValidateValue" ValidationDelay="3">

                <MudCardHeader>
                    <CardHeaderContent>
                        <MudImage Fluid="true" Src="/images/JMLogo.png" />
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudTextField @bind-Value="Model!.Document"
                                  For="@(() => Model!.Document)"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Required="true"
                                  RequiredError="@_translator["FieldRequired"]"
                                  Variant="Variant.Outlined"
                                  Label="@_translator["Document"]"
                                  InputType="InputType.Number" />

                    <MudTextField @bind-Value="Model!.Password"
                                  For="@(() => Model!.Password)"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Required="true"
                                  OnlyValidateIfDirty="true"
                                  RequiredError="@_translator["FieldRequired"]"
                                  Variant="Variant.Outlined"
                                  Label="@_translator["Password"]"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@PasswordInputIcon"
                                  OnAdornmentClick="ShowPassword"
                                  AdornmentAriaLabel="Show Password"
                                  InputType="PasswordInputType" />

                    <LanguageSelector />

                </MudCardContent>

                <MudCardActions Style="justify-content: space-evenly;">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="!form?.IsValid ?? false"
                               OnClick="@(async () => await Submit())">


                        @if (Busy)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@_translator["Processing"]</MudText>
                        }
                        else
                        {
                            <MudText>@_translator["LogIn"]</MudText>
                        }
                    </MudButton>

                </MudCardActions>
            </MudForm>

            
        </MudCard>
    </section>

    <section class="column side-section">
    </section>
</div>

@code {

    [SupplyParameterFromForm]
    public AuthenticateDto? Model { get; set; }

    public AuthenticateValidator AuthValidator = new AuthenticateValidator();

    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    InputType PasswordInputType = InputType.Password;
    bool showPassword = false;

    [Inject]
    ISnackbar? SnackBar { get; set; }

    MudForm? form;

    bool Busy { get; set; } = false;

    protected override void OnInitialized()
    {
        Model ??= new AuthenticateDto();
    }

    private async Task Submit()
    {
        Busy = true;
        form?.Validate();

        if (!form?.IsValid ?? false)
        {
            SnackBar?.Add(_translator["VerifyYourInputs"], Severity.Error);
            return;
        }

        var result = await authService.LogIn(Model!);

        if (result)
        {
            navigation.NavigateTo("/");
            SnackBar?.Add(_translator["AuthenticationSuccess"], Severity.Success);
        }

        else
            SnackBar?.Add(_translator["AuthenticationFailed"], Severity.Error);

        Busy = false;
    }

    void ShowPassword()
    {
        @if (showPassword)
        {
            showPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInputType = InputType.Password;
        }
        else
        {
            showPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInputType = InputType.Text;
        }
    }
}
