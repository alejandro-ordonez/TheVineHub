@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.DiscipleJourney.Enums
@using JMMinistry.Web.Pages.User.Components
@using JMMinistry.Web.Store.DiscipleStepsUseCase
@using JMMinistry.Web.Store.DiscipleStepsUseCase.Actions
@using JMMinistry.Web.Store.StepDisciplesUseCase
@using JMMinistry.Web.Store.StepDisciplesUseCase.Actions
@using JMMinistry.Web.Store.PageUseCase
@using JMMinistry.Web.Pages.User.Dialogs
@using JMMinistry.Web.Shared.Components

@attribute [Route(Routes.DiscipleStep + "/{StepId:int}")]
@attribute [Authorize]
@layout MainLayout

@inherits FluxorComponent

@inject IState<DiscipleStepsState> DiscipleStepsState
@inject IState<StepDisciplesState> StepDisciplesState
@inject IDispatcher Dispatcher
@inject IStringLocalizer<UIStrings> Translator
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@if (_step is not null)
{
    <MudPaper Style="margin: 1rem 0px">
        <MudToolBar>
            <MudText Typo="Typo.subtitle1">
                @Translator["InProgress"]: @InProgressCount | @Translator["Completed"]: @CompletedCount | @Translator["Total", TotalDisciples]
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Tertiary" OnClick="OpenAddCompletionDialog" />
        </MudToolBar>
    </MudPaper>

    @if (StepDisciplesState.Value.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }

    @foreach (var group in StepDisciplesState.Value.Groups)
    {
        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">
            @(string.IsNullOrEmpty(group.CellName) ? Translator["WithoutCell"] : group.CellName)
            @if (!string.IsNullOrEmpty(group.LeaderName))
            {
                <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary"> — @group.LeaderName</MudText>
            }
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group.Disciples.Count</MudChip>
        </MudText>

        <div class="users-grid">
            @foreach (var disciple in group.Disciples)
            {
                <div style="position: relative;">
                    <UserCard User="disciple" OnClick="@(EventCallback.Factory.Create<UserEventArgs>(this, ShowUserDetails))" />
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0 4px; flex-wrap: wrap; gap: 2px;">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetDiscipleStatusColor(disciple.StepStatus)"
                                 Variant="Variant.Filled">
                            @GetDiscipleStatusLabel(disciple.StepStatus)
                            — @disciple.LastUpdated.ToString("d")
                        </MudChip>
                        @if (disciple.CycleEnrollmentSummary is not null)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(disciple.CycleEnrollmentSummary.Status == StepStatus.Enrolled || disciple.CycleEnrollmentSummary.Status == StepStatus.InPrayers ? Color.Tertiary : Color.Error)"
                                     Variant="Variant.Outlined">
                                @disciple.CycleEnrollmentSummary.CycleName
                                (@disciple.CycleEnrollmentSummary.AttendanceCount)
                            </MudChip>
                        }
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            @if (!(_step?.RequiresAdminApproval ?? false)
                                && disciple.StepStatus is StepStatus.InProgress or StepStatus.Enrolled or StepStatus.InPrayers)
                            {
                                @if (disciple.CycleEnrollmentSummary is null || disciple.CycleEnrollmentSummary.CycleEnded)
                                {
                                    var label = Translator["MarkCompleted"].ToString();
                                    if (disciple.CycleEnrollmentSummary is { } ces)
                                    {
                                        label += $" ({ces.AttendanceCount}/{ces.MinAttendanceRequired})";
                                    }
                                    <MudMenuItem OnClick="@(() => MarkCompleted(disciple.Document))">@label</MudMenuItem>
                                }
                            }
                            <MudMenuItem OnClick="@(() => UpdateStatus(disciple.Document, StepStatus.Abandoned))">@Translator["MarkAbandoned"]</MudMenuItem>
                        </MudMenu>
                    </div>
                </div>
            }
        </div>
    }

    @if (!StepDisciplesState.Value.IsLoading && TotalDisciples == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">@Translator["NoDisciples"]</MudAlert>
    }
}
else if (!DiscipleStepsState.Value.IsLoading)
{
    <MudAlert Severity="Severity.Warning">@Translator["NotFound"]</MudAlert>
}
else
{
    <MudProgressCircular Indeterminate="true" />
}

@code {
    [Parameter] public int StepId { get; set; }

    private Common.Dtos.DiscipleJourney.DiscipleStepDto? _step;

    private IEnumerable<Common.Dtos.DiscipleJourney.StepDiscipleDto> AllDisciples =>
        StepDisciplesState.Value.Groups.SelectMany(g => g.Disciples);

    private int TotalDisciples => AllDisciples.Count();

    private int InProgressCount => AllDisciples.Count(d => d.StepStatus is StepStatus.InProgress or StepStatus.Enrolled or StepStatus.InPrayers);

    private int CompletedCount => AllDisciples.Count(d => d.StepStatus == StepStatus.Completed);

    Color GetDiscipleStatusColor(StepStatus? status) => status switch
    {
        StepStatus.InProgress => Color.Info,
        StepStatus.Enrolled => Color.Success,
        StepStatus.InPrayers => Color.Warning,
        StepStatus.Completed => Color.Default,
        StepStatus.Abandoned => Color.Error,
        _ => Color.Default
    };

    string GetDiscipleStatusLabel(StepStatus? status) => status switch
    {
        StepStatus.InProgress => Translator["InProgress"],
        StepStatus.Enrolled => Translator["Enrolled"],
        StepStatus.InPrayers => Translator["InPrayers"],
        StepStatus.Completed => Translator["Completed"],
        StepStatus.Abandoned => Translator["Abandoned"],
        _ => ""
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchDiscipleStepsAction());
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        UpdateStep();
    }

    private void UpdateStep()
    {
        _step = DiscipleStepsState.Value.Steps.FirstOrDefault(s => s.Id == StepId)
             ?? DiscipleStepsState.Value.Steps.SelectMany(s => s.SubSteps).FirstOrDefault(s => s.Id == StepId);

        if (_step is not null)
        {
            Dispatcher.Dispatch(new SetTitleAction { Title = _step.Name });
            Dispatcher.Dispatch(new FetchStepDisciplesAction { StepId = StepId });
        }
    }

    private async Task ShowUserDetails(UserEventArgs user)
    {
        var parameters = new DialogParameters<UserDetailsDialog>
        {
            { x => x.Document, user.Document },
            { x => x.ShowRemoveButton, false }
        };

        var dialog = await DialogService.ShowAsync<UserDetailsDialog>(Translator["Details"], parameters);
        var result = await dialog.GetReturnValueAsync<DialogResult<UserEventArgs>>();

        if (result?.Data is not null && result.Option == DialogResultOption.PrimaryButton)
        {
            NavigationManager.NavigateTo($"{Routes.User}/{user.Document}");
        }
    }

    private async Task OpenAddCompletionDialog()
    {
        if (_step is null) return;

        var parameters = new DialogParameters<AddStepCompletionDialog>
        {
            { x => x.StepId, StepId },
            { x => x.HasRequirements, _step.RequirementIds.Count > 0 },
            { x => x.RequiresCycle, _step.RequiresCycle }
        };

        var dialogTitle = _step.RequiresCycle ? Translator["EnrollDisciples"] : Translator["AddStepCompletion"];
        var dialog = await DialogService.ShowAsync<AddStepCompletionDialog>(dialogTitle, parameters);
        var result = await dialog.GetReturnValueAsync<AddStepCompletionDialog.StepCompletionDialogResult>();

        if (result is not null && result.Documents.Count > 0)
        {
            if (result.CycleId.HasValue)
            {
                Dispatcher.Dispatch(new EnrollDisciplesAction
                {
                    StepId = StepId,
                    CycleId = result.CycleId.Value,
                    Documents = result.Documents.ToList(),
                    InitialStatus = result.InitialStatus
                });
            }
            else
            {
                Dispatcher.Dispatch(new CompleteStepAction
                {
                    StepId = StepId,
                    Documents = result.Documents.ToList(),
                    CompletionDate = result.CompletionDate
                });
            }
        }
    }

    private async Task MarkCompleted(string discipleId)
    {
        var dialog = await DialogService.ShowAsync<SelectDateDialog>(Translator["MarkCompleted"]);
        var result = await dialog.GetReturnValueAsync<DateOnly?>();

        if (result is not null)
        {
            Dispatcher.Dispatch(new UpdateStepCompletionAction
            {
                StepId = StepId,
                DiscipleId = discipleId,
                Status = StepStatus.Completed,
                CompletionDate = result
            });
        }
    }

    private void UpdateStatus(string discipleId, StepStatus status)
    {
        Dispatcher.Dispatch(new UpdateStepCompletionAction
        {
            StepId = StepId,
            DiscipleId = discipleId,
            Status = status
        });
    }
}
