@using Fluxor
@using JMMinistry.Common.Dtos.Cell
@using JMMinistry.Common.Dtos.Common
@using JMMinistry.Web.Api
@using JMMinistry.Web.Store.CellUseCase

@inject IStringLocalizer<UIStrings> translator;
@inject ILocationApi locationApi;

@inherits Fluxor.Blazor.Web.Components.FluxorComponent;

<Dialog Result="CreateCellDto"
        Color="Color.Primary"
        PrimaryText="@PrimaryButtonText"
        IsFormValid="cellForm?.IsValid">
    <Content>
        <MudForm Model="CreateCellDto" @ref="cellForm">

            <MudTextField @bind-Value="CreateCellDto.Name"
                          For="@(() => CreateCellDto.Name)"
                          Immediate="true"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Name"]"
                          InputType="InputType.Text" />

            <MudTextField @bind-Value="CreateCellDto.Description"
                          For="@(() => CreateCellDto.Description)"
                          Immediate="true"
                          Required="true"
                          OnlyValidateIfDirty="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Description"]"
                          InputType="InputType.Text" />

            <MudAutocomplete T="CityDto" Label="@translator["City"]" @bind-Value="CreateCellDto.City"
                             SearchFunc="@((searchTerm, token) => locationApi.GetCities(searchTerm))" 
                             ToStringFunc="@(e=> e==null?null : e.Name)"
                             Required="true"
                             Variant="Variant.Outlined"
                             ShowProgressIndicator="true" />

            @if(CreateCellDto.City is not null && CreateCellDto.City.Localities.Count > 0)
            {
                <MudAutocomplete T="LocalityDto" Label="@translator["Locality"]" @bind-Value="CreateCellDto.Locality"
                                 SearchFunc="@((searchTerm, token) => Task.FromResult(CreateCellDto.City?.GetLocalities(searchTerm)))"
                                 ToStringFunc="@(e=> e==null?null : e.Name)"
                                 Variant="Variant.Outlined"
                                 ShowProgressIndicator="true" />
            }


            <MudTextField @bind-Value="CreateCellDto.Address"
                          For="@(() => CreateCellDto.Address)"
                          Immediate="true"
                          Required="true"
                          OnlyValidateIfDirty="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Address"]"
                          InputType="InputType.Text" />

            <MudSelect @bind-Value="CreateCellDto.Day"
                       For="@(() => CreateCellDto.Day)"
                       Label="@translator["Day"]"
                       Placeholder="@translator["SelectDay"]"
                       Required="true"
                       RequiredError="@translator["FieldRequired"]"
                       Variant="Variant.Outlined">

                @foreach (var day in Enum.GetValues<DayOfWeek>())
                {
                    <MudSelectItem T="DayOfWeek?" Value="day">@translator[day.ToString()]</MudSelectItem>
                }
            </MudSelect>

        </MudForm>
    </Content>
</Dialog>

@code {
    [SupplyParameterFromForm]
    CellDto CreateCellDto { get; set; } = new CellDto();

    [Parameter]
    public string? PrimaryButtonText { get; set; }

    MudForm? cellForm;

    [Inject]
    IState<CellState>? CurrentCell { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if(CurrentCell?.Value?.Cell is not null)
        {
            CreateCellDto = new CellDto
            {
                Id = CurrentCell.Value.Cell.Id,
                Name = CurrentCell.Value.Cell.Name,
                Description = CurrentCell.Value.Cell.Description,
                Address = CurrentCell.Value.Cell.Address,
                City = CurrentCell.Value.Cell.City,
                Locality = CurrentCell.Value.Cell.Locality,
                Day = CurrentCell.Value.Cell.Day,
            };
        }
    }
}
