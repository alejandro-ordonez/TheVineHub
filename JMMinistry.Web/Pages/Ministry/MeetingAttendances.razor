@using Fluxor
@using JMMinistry.Web.Store.PageUseCase

@attribute [Route(Routes.MeetingAttendances)]
@attribute [Authorize]
@layout MainLayout

@inject IDispatcher Dispatcher
@inject IStringLocalizer<UIStrings> Translator

<MudAlert Severity="Severity.Info">@Translator["ComingSoon"]</MudAlert>

@code {
    protected override void OnInitialized()
    {
        Dispatcher.Dispatch(new SetTitleAction { Title = Translator["Attendances"] });
    }
}
