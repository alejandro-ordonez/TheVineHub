@using JMMinistry.Common.Dtos.Cell
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Pages.User;
@using JMMinistry.Web.Api

@attribute [Route(Routes.Ministry)]
@attribute [Authorize]
@layout MainLayout

<PageTitle>@PageTitle</PageTitle>

<MudPaper Class="ma-2">
    <Header Title="@translator["Ministry"]">
        <ActionMenu>
            <MudFab StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary"
                    Disabled="@IsBusy"
                    Size="Size.Small"
                    OnClick="() => OpenAddCell()">
            </MudFab>
        </ActionMenu>
    </Header>
</MudPaper>

@if (!Cells.Any())
{
    <MudText Typo="Typo.h6">@translator["NoCells"]</MudText>
}

<MudExpansionPanels Style="">

    @foreach (var cell in Cells.Values)
    {
        <MudExpansionPanel Class="ma-2" HideIcon="true" Expanded="true">
            <TitleContent>
                <div class="d-flex flex-row" style="justify-content: space-between; padding: 0px 1rem">
                    <MudIcon Icon="@Icons.Material.Filled.Info" class="mr-3"></MudIcon>
                    <MudText Typo="Typo.h5">@cell.Name</MudText>
                    
                    <div>
                        <MudFab StartIcon="@Icons.Material.Filled.Add"
                                Color="Color.Primary"
                                Disabled="@IsBusy"
                                Size="Size.Small"
                                OnClick="() => OpenAddDisciple(cell.Id)">
                        </MudFab>

                        <MudFab StartIcon="@Icons.Material.Filled.Add"
                                Color="Color.Primary"
                                Disabled="@IsBusy"
                                Size="Size.Small"
                                OnClick="() => OpenAddDisciple(cell.Id)">
                        </MudFab>
                    </div>
                </div>
            </TitleContent>

            <ChildContent>

                <div class="users-grid">
                    @if (Disciples.TryGetValue(cell.Id, out var disciples))
                    {
                        foreach (var disciple in disciples)
                        {
                            <UserCard User="disciple" OnClick="EventCallback.Factory.Create<UserEventArgs>(this, ShowUserDetails)" />
                        }
                    }

                </div>

            </ChildContent>

        </MudExpansionPanel>
    }
</MudExpansionPanels>
