@page "/ministry"
@using JMMinistry.Common.Dtos.Cell
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Pages.User;
@using JMMinistry.Web.Api
@attribute [Authorize]

<PageTitle>@PageTitle</PageTitle>

<MudPaper Class="ma-2">
    <Header Title="@translator["Ministry"]">
        <ActionMenu>
            <MudFab StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary"
                    Disabled="@AddDiscipleOpen"
                    Size="Size.Small"
                    OnClick="() => OpenAddCell()">
            </MudFab>
        </ActionMenu>
    </Header>
</MudPaper>


<MudTabs Elevation="2" Rounded="true" Class="flex-grow-1 ma-2" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="@translator["Cells"]">
        
        @if (!Cells.Any())
        {
            <MudText Typo="Typo.h6">@translator["NoCells"]</MudText>
        }

        <MudExpansionPanels Style="">

            @foreach (var cell in Cells.Values)
            {
                <MudExpansionPanel HideIcon="true" Expanded="true">
                    <TitleContent>
                        <div class="d-flex flex-row" style="justify-content: space-between; padding: 0px 1rem">
                            <MudIcon Icon="@Icons.Material.Filled.Info" class="mr-3"></MudIcon>
                            <MudText Typo="Typo.h5">@cell.Name</MudText>
                            <MudFab StartIcon="@Icons.Material.Filled.Add"
                                    Color="Color.Primary"
                                    Disabled="@AddDiscipleOpen"
                                    Size="Size.Small"
                                    OnClick="() => OpenAddDisciple(cell.Id)">
                            </MudFab>
                        </div>
                    </TitleContent>

                    <ChildContent>

                        <UsersTable UseServer="false"
                                    Users="cell.Disciples"
                                    EditUser="EditDisciple"
                                    DeleteUser="RemoveDisciple"/>

                        <MudTable Items="cell.Disciples">
                            <HeaderContent>
                                <MudTh>@translator["Document"]</MudTh>
                                <MudTh>@translator["Name"]</MudTh>
                                <MudTh>@translator["LastName"]</MudTh>
                                <MudTh>@translator["Birthday"]</MudTh>
                                <MudTh>@translator["Locality"]</MudTh>
                                <MudTh>@translator["MinistryStatus"]</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="@translator["Document"]">@context.Document</MudTd>
                                <MudTd DataLabel="@translator["Name"]">@context.Name</MudTd>
                                <MudTd DataLabel="@translator["LastName"]">@context.LastName</MudTd>
                                <MudTd DataLabel="@translator["Birthday"]">@context.Birthday</MudTd>
                                <MudTd DataLabel="@translator["Locality"]">@context.Locality</MudTd>
                                <MudTd DataLabel="@translator["MinistryStatus"]">@translator[context.MinistryStatus?.ToString() ?? "None"]</MudTd>
                            </RowTemplate>
                        </MudTable>

                    </ChildContent>

                </MudExpansionPanel>
            }
        </MudExpansionPanels>


    </MudTabPanel>


    <MudTabPanel Text="@translator["GainedUsers"]">
        <MudText>Content Two</MudText>
    </MudTabPanel>
</MudTabs>




<Popup Open="@AddDiscipleOpen">
    <Content>

        <UsersTable DefaultUserCriteria="InitialCriteria" Selectable="true" Selected="DisciplesSelected">

        </UsersTable>
       
    </Content>

    <Actions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@(async () => await SubmitAddDisciples())">


            @if (IsBusy)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>@translator["Create"]</MudText>
            }

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="() => Cancel()">
            <MudText>@translator["Cancel"]</MudText>
        </MudButton>
    </Actions>
</Popup>


<Popup Open="@AddCellOpen">
    <Content>
        <MudText Typo="Typo.h6">@translator["RegisterCell"]</MudText>
        <MudDivider />

        <MudForm Model="CreateCellDto" @ref="cellForm">

            <MudTextField @bind-Value="CreateCellDto.Name"
                          For="@(() => CreateCellDto.Name)"
                          Immediate="true"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Name"]"
                          InputType="InputType.Text" />

            <MudTextField @bind-Value="CreateCellDto.Description"
                          For="@(() => CreateCellDto.Description)"
                          Immediate="true"
                          Required="true"
                          OnlyValidateIfDirty="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Description"]"
                          InputType="InputType.Text" />
            
        </MudForm>

    </Content>

    <Actions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@(async () => await SubmitAddCell())">


            @if (IsBusy)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>@translator["Create"]</MudText>
            }

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="() => Cancel()">
            <MudText>@translator["Cancel"]</MudText>
        </MudButton>
    </Actions>
</Popup>
