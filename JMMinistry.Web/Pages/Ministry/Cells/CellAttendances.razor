@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IStringLocalizer<UIStrings> translator;


<MudPaper Style="margin: 1rem 0px">
    <MudToolBar>
        <MudText Typo="Typo.subtitle1">@translator["Total", State.Value.Attendances.Count ]</MudText>
        <MudSpacer />
    </MudToolBar>
</MudPaper>


@if (State.Value.IsLoading)
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
}

<div class="dynamic-grid">
    @foreach(var attendance in State.Value.Attendances)
    {
        <MudPaper class="d-flex flex-row pa-2 mud-ripple" Style="align-items: center;" @onclick="@(async() => await OpenAttendanceDetails(attendance))">
            <MudAvatar Class="avatar-icon ma-1" Variant="Variant.Outlined" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.TwoTone.CalendarMonth"/>
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle1">@attendance.Date.ToShortDateString()</MudText>
                <MudText Typo="Typo.subtitle2">@translator["Attendees", attendance.Attendees.Count]</MudText>
                <MudText Typo="Typo.subtitle2">@translator["Missing", attendance.MissingAttendees.Count]</MudText>
            </div>
        </MudPaper>
    }
</div>
