@using JMMinistry.Web.Pages.User

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IStringLocalizer<UIStrings> translator;

<MudPaper Style="margin: 1rem 0px">
    <MudToolBar>
        <MudText Typo="Typo.subtitle1">@translator["Total", State.Value.Disciples.Count]</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Tertiary" OnClick="OpenAddDisciple" />
        
        @if (State.Value.Disciples.Count > 0)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Checklist" Color="Color.Tertiary" OnClick="@(() => { AddAttendanceEnabled = !AddAttendanceEnabled; })" />
        }
    </MudToolBar>
</MudPaper>


<div class="users-grid">
    @foreach (var disciple in State.Value.Disciples)
    {
        <UserCard User="disciple" 
                  OnClick="EventCallback.Factory.Create<UserEventArgs>(this, ShowUserDetails)" 
                  EnableSelection="AddAttendanceEnabled"
                  @ref="ComponentRef" />
    }

</div>

@if (AddAttendanceEnabled)
{
    <MudPaper Style="margin: 1rem 0px">
        <MudToolBar>
            <MudTextField Style="flex-grow: 1" 
                          @bind-Value="AttendanceNotes" 
                          Typo="Typo.body1"/>

            <MudButton Style="margin: 0px 1rem;" Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => { AddAttendanceEnabled = false; })">@translator["Cancel"]</MudButton>
            <MudButton Style="margin: 0px 1rem;" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAttendance">@translator["Add"]</MudButton>
        </MudToolBar>
    </MudPaper>
}


