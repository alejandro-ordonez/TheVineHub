@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.DiscipleJourney
@using JMMinistry.Common.Dtos.DiscipleJourney.Enums
@using JMMinistry.Web.Pages.User.Components
@using JMMinistry.Web.Pages.User.Dialogs
@using JMMinistry.Web.Shared.Components
@using JMMinistry.Web.Store.StepDisciplesUseCase
@using JMMinistry.Web.Store.StepDisciplesUseCase.Actions
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api

@inherits FluxorComponent

@inject IState<StepDisciplesState> StepDisciplesState
@inject IDispatcher Dispatcher
@inject IStringLocalizer<UIStrings> Translator
@inject IDialogService DialogService
@inject IUserApi UserApi

<MudDialog>
    <DialogContent>
        @if (StepDisciplesState.Value.IsLoadingEligible)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (StepDisciplesState.Value.EligibleGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">@Translator["NoEligibleDisciples"]</MudAlert>
        }
        else
        {
            @foreach (var group in StepDisciplesState.Value.EligibleGroups)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">
                    @(string.IsNullOrEmpty(group.CellName) ? Translator["WithoutCell"] : group.CellName)
                    @if (!string.IsNullOrEmpty(group.LeaderName))
                    {
                        <MudText Typo="Typo.caption" Inline="true" Color="Color.Secondary"> — @group.LeaderName</MudText>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group.Disciples.Count</MudChip>
                </MudText>

                <div class="users-grid">
                    @foreach (var disciple in group.Disciples)
                    {
                        <UserCard User="disciple"
                                  EnableSelection="true"
                                  Outlined="true"
                                  Selected="@SelectedDocuments.Contains(disciple.Document)"
                                  SelectedChanged="@(selected => ToggleSelection(disciple.Document, selected))" />
                    }
                </div>
            }
        }

        @if (RequiresCycle)
        {
            @if (StepDisciplesState.Value.IsLoadingActiveCycles)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }
            else if (StepDisciplesState.Value.ActiveCycles.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">@Translator["NoCycles"]</MudAlert>
            }
            else
            {
                var allCycles = StepDisciplesState.Value.ActiveCycles;
                var years = allCycles.Select(c => c.EndDate.Year).Distinct().OrderByDescending(y => y).ToList();
                var filteredCycles = _selectedYear.HasValue
                    ? allCycles.Where(c => c.EndDate.Year == _selectedYear.Value).ToList()
                    : allCycles;

                <MudStack Row="true" Class="mt-4" Spacing="2">
                    <MudSelect T="int?" @bind-Value="_selectedYear"
                               Label="@Translator["Year"]"
                               Variant="Variant.Outlined"
                               Style="max-width: 120px;">
                        <MudSelectItem T="int?" Value="@((int?)null)">@Translator["All"]</MudSelectItem>
                        @foreach (var year in years)
                        {
                            <MudSelectItem T="int?" Value="@year">@year</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="_selectedCycleId"
                               Label="@Translator["SelectCycle"]"
                               Variant="Variant.Outlined"
                               Required="true"
                               Style="flex: 1;">
                        @foreach (var cycle in filteredCycles)
                        {
                            <MudSelectItem T="int?" Value="@cycle.Id">
                                @cycle.Name
                                @if (cycle.IsOpen)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="ml-2">@Translator["Open"]</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2">@Translator["Closed"]</MudChip>
                                }
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>

                @if (_selectedCycleId.HasValue && SelectedCycle is { IsOpen: true })
                {
                    <MudSelect T="StepStatus?" @bind-Value="_selectedInitialStatus"
                               Label="@Translator["InitialStatus"]"
                               Variant="Variant.Outlined"
                               Class="mt-4">
                        <MudSelectItem T="StepStatus?" Value="@((StepStatus?)StepStatus.Enrolled)">@Translator["Enrolled"]</MudSelectItem>
                        <MudSelectItem T="StepStatus?" Value="@((StepStatus?)StepStatus.InPrayers)">@Translator["InPrayers"]</MudSelectItem>
                    </MudSelect>
                }
            }
        }
        else
        {
            <MudDatePicker Class="mt-4" @bind-Date="_completionDate" Label="@Translator["CompletionDate"]" Variant="Variant.Outlined" />
        }

        @if (!HasRequirements && !RequiresCycle)
        {
            <MudButton Class="mt-4"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAddUserDialog">
                @Translator["AddNewUser"]
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Translator["Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(SelectedDocuments.Count == 0 || (RequiresCycle && _selectedCycleId is null))"
                   OnClick="Submit">
            @(RequiresCycle ? Translator["EnrollDisciples"] : Translator["Add"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public int StepId { get; set; }

    [Parameter]
    public bool HasRequirements { get; set; }

    [Parameter]
    public bool RequiresCycle { get; set; }

    private HashSet<string> SelectedDocuments { get; set; } = [];
    private DateTime? _completionDate = DateTime.Today;
    private int? _selectedYear;
    private int? _selectedCycleId;
    private StepStatus? _selectedInitialStatus = StepStatus.Enrolled;

    private StepCycleDto? SelectedCycle => _selectedCycleId.HasValue
        ? StepDisciplesState.Value.ActiveCycles.FirstOrDefault(c => c.Id == _selectedCycleId.Value)
        : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchEligibleDisciplesAction { StepId = StepId });
        if (RequiresCycle)
        {
            Dispatcher.Dispatch(new FetchActiveCyclesAction { StepId = StepId });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Medium
            };

            await MudDialog.SetOptionsAsync(options);
        }
    }

    private void ToggleSelection(string document, bool selected)
    {
        if (selected)
            SelectedDocuments.Add(document);
        else
            SelectedDocuments.Remove(document);
    }

    private async Task OpenAddUserDialog()
    {
        var dialog = await DialogService.ShowAsync<AddUserDialog>(Translator["AddNewUser"]);
        var result = await dialog.GetReturnValueAsync<DialogResult<AddUserDialog.AddUserResult>>();

        if (result?.Data is null)
            return;

        var userDto = result.Data.User;
        var response = userDto.IsUpdate
            ? await UserApi.UpdateUser(userDto)
            : await UserApi.CreateUser(userDto);

        if (response?.Success ?? false)
        {
            if (result.Data.TempPhotoId is not null)
                await UserApi.AssignTempPhotoAsync(userDto.Document, result.Data.TempPhotoId);

            SelectedDocuments.Add(userDto.Document);
            Dispatcher.Dispatch(new FetchEligibleDisciplesAction { StepId = StepId });
        }
    }

    private void Submit() => MudDialog?.Close(new StepCompletionDialogResult
    {
        Documents = SelectedDocuments,
        CompletionDate = DateOnly.FromDateTime(_completionDate ?? DateTime.Today),
        CycleId = _selectedCycleId,
        InitialStatus = _selectedCycleId.HasValue ? _selectedInitialStatus : null
    });

    private void Cancel() => MudDialog?.Cancel();

    public record StepCompletionDialogResult
    {
        public HashSet<string> Documents { get; set; } = [];
        public DateOnly CompletionDate { get; set; }
        public int? CycleId { get; set; }
        public StepStatus? InitialStatus { get; set; }
    }
}
