@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.DiscipleJourney
@using JMMinistry.Web.Store.DiscipleStepsUseCase
@using JMMinistry.Web.Store.DiscipleStepsUseCase.Actions
@using JMMinistry.Web.Store.StepCyclesUseCase
@using JMMinistry.Web.Store.StepCyclesUseCase.Actions
@using JMMinistry.Web.Store.PageUseCase
@using JMMinistry.Web.Shared.Components

@attribute [Route(Routes.StepCycleAdmin + "/{StepId:int}")]
@attribute [Authorize(Roles = "Admin")]
@layout MainLayout

@inherits FluxorComponent

@inject IState<DiscipleStepsState> StepsState
@inject IState<StepCyclesState> CyclesState
@inject IDispatcher Dispatcher
@inject IDialogService DialogService
@inject IStringLocalizer<UIStrings> translator
@inject NavigationManager NavigationManager

<MudPaper Class="ma-2">
    <Header Title="@(_step?.Name ?? translator["Cycles"])">
        <ActionMenu>
            <MudFab StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary"
                    Size="Size.Small"
                    Disabled="@CyclesState.Value.IsLoading"
                    OnClick="OpenCreateDialog" />
        </ActionMenu>
    </Header>
</MudPaper>

@if (CyclesState.Value.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@if (CyclesState.Value.Cycles.Count == 0 && !CyclesState.Value.IsLoading)
{
    <MudAlert Severity="Severity.Info" Class="ma-2">@translator["NoCycles"]</MudAlert>
}

<div class="ma-2 cards-grid">
    @foreach (var cycle in CyclesState.Value.Cycles)
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@cycle.Name</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string"
                             Color="@(cycle.IsOpen ? Color.Success : Color.Default)"
                             Size="Size.Small">
                        @(cycle.IsOpen ? translator["Open"] : translator["Closed"])
                    </MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2">@cycle.StartDate.ToString("d") — @cycle.EndDate.ToString("d")</MudText>
                    <MudText Typo="Typo.body2">@translator["MinAttendance"]: @cycle.MinAttendanceRequired</MudText>
                    <MudText Typo="Typo.body2">@translator["Sessions"]: @cycle.SessionCount | @translator["Enrolled"]: @cycle.EnrolledCount</MudText>
                    @if (cycle.EnrollmentDeadline.HasValue)
                    {
                        <MudText Typo="Typo.caption">@translator["EnrollmentDeadline"]: @cycle.EnrollmentDeadline.Value.ToString("d")</MudText>
                    }
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton Size="Size.Small"
                           Color="Color.Primary"
                           Variant="Variant.Text"
                           OnClick="@(() => NavigationManager.NavigateTo($"{Routes.CycleDetailsAdmin}/{cycle.Id}"))">
                    @translator["Details"]
                </MudButton>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => OpenEditDialog(cycle))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => ConfirmDelete(cycle))" />
            </MudCardActions>
        </MudCard>
    }
</div>

@code {
    [Parameter] public int StepId { get; set; }

    private DiscipleStepDto? _step;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchDiscipleStepsAction());
        Dispatcher.Dispatch(new FetchStepCyclesAction { StepId = StepId });
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _step = StepsState.Value.Steps.SelectMany(s => new[] { s }.Concat(s.SubSteps))
            .FirstOrDefault(s => s.Id == StepId);

        if (_step is not null)
            Dispatcher.Dispatch(new SetTitleAction { Title = $"{translator["Cycles"]} — {_step.Name}" });
    }

    async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<StepCycleDialog>(translator["CreateCycle"]);
        var result = await dialog.GetReturnValueAsync<DialogResult<StepCycleDialog.StepCycleDialogResult>>();

        if (result?.Data is null) return;

        Dispatcher.Dispatch(new CreateStepCycleAction
        {
            StepId = StepId,
            Dto = new CreateStepCycleDto
            {
                Name = result.Data.Name,
                StartDate = result.Data.StartDate,
                EndDate = result.Data.EndDate,
                MinAttendanceRequired = result.Data.MinAttendanceRequired,
                EnrollmentDeadline = result.Data.EnrollmentDeadline
            }
        });
    }

    async Task OpenEditDialog(StepCycleDto cycle)
    {
        var parameters = new DialogParameters<StepCycleDialog>
        {
            { x => x.ExistingCycle, cycle }
        };

        var dialog = await DialogService.ShowAsync<StepCycleDialog>(translator["EditCycle"], parameters);
        var result = await dialog.GetReturnValueAsync<DialogResult<StepCycleDialog.StepCycleDialogResult>>();

        if (result?.Data is null) return;

        Dispatcher.Dispatch(new UpdateStepCycleAction
        {
            StepId = StepId,
            CycleId = cycle.Id,
            Dto = new UpdateStepCycleDto
            {
                Name = result.Data.Name,
                StartDate = result.Data.StartDate,
                EndDate = result.Data.EndDate,
                MinAttendanceRequired = result.Data.MinAttendanceRequired,
                IsOpen = result.Data.IsOpen,
                EnrollmentDeadline = result.Data.EnrollmentDeadline
            }
        });
    }

    async Task ConfirmDelete(StepCycleDto cycle)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ButtonText, translator["Remove"] },
            { x => x.ContentText, translator["AreYouSure", translator["Remove"], translator["Cycle"], cycle.Name] },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(translator["Remove"], parameters);
        var result = await dialog.Result;

        if (!result?.Canceled ?? false)
            Dispatcher.Dispatch(new DeleteStepCycleAction { StepId = StepId, CycleId = cycle.Id });
    }
}
