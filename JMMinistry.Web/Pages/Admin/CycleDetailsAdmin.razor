@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.DiscipleJourney
@using JMMinistry.Common.Dtos.DiscipleJourney.Enums
@using JMMinistry.Web.Store.CycleDetailsUseCase
@using JMMinistry.Web.Store.CycleDetailsUseCase.Actions
@using JMMinistry.Web.Store.StepCyclesUseCase
@using JMMinistry.Web.Store.StepCyclesUseCase.Actions
@using JMMinistry.Web.Store.PageUseCase
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Shared.Components

@attribute [Route(Routes.CycleDetailsAdmin + "/{CycleId:int}")]
@attribute [Authorize(Roles = "Admin")]
@layout MainLayout

@inherits FluxorComponent

@inject IState<StepCyclesState> CyclesState
@inject IState<CycleDetailsState> DetailsState
@inject IDispatcher Dispatcher
@inject IDialogService DialogService
@inject IStringLocalizer<UIStrings> translator

@{
    var cycle = CyclesState.Value.Cycles.FirstOrDefault(c => c.Id == CycleId);
    var allEnrollments = DetailsState.Value.Enrollments;
    var canClose = cycle is { IsOpen: true }
        && allEnrollments.Count > 0
        && allEnrollments.All(e => e.Status is StepStatus.Completed or StepStatus.Abandoned);
}

<MudPaper Class="ma-2">
    <Header Title="@(cycle?.Name ?? translator["Details"])">
        <ActionMenu>
            @if (cycle is { IsOpen: true })
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Disabled="@(!canClose)"
                           OnClick="CloseCycle">
                    @translator["CloseCycle"]
                </MudButton>
            }
        </ActionMenu>
    </Header>
</MudPaper>

@if (DetailsState.Value.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

<MudTabs Class="ma-2" Rounded="true" ApplyEffectsToContainer="true">
    @* ===== Enrollments Tab ===== *@
    <MudTabPanel Text="@translator["Enrollments"]" class="pa-4" Icon="@Icons.Material.Filled.People">
        @if (allEnrollments.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@translator["NoEnrollments"]</MudAlert>
        }
        else
        {
            var inPrayers = allEnrollments.Where(e => e.Status == StepStatus.InPrayers).ToList();
            var active = allEnrollments.Where(e => e.Status is StepStatus.Enrolled or StepStatus.Completed).ToList();
            var abandoned = allEnrollments.Where(e => e.Status == StepStatus.Abandoned).ToList();

            @if (inPrayers.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@translator["InPrayers"] <MudChip T="string" Size="Size.Small" Color="Color.Info">@inPrayers.Count</MudChip></MudText>
                @EnrollmentTable(inPrayers)
            }

            @if (active.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@translator["Enrolled"] <MudChip T="string" Size="Size.Small" Color="Color.Success">@active.Count</MudChip></MudText>
                @EnrollmentTable(active)
            }

            @if (abandoned.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1" Color="Color.Error">@translator["Abandoned"] <MudChip T="string" Size="Size.Small" Color="Color.Error">@abandoned.Count</MudChip></MudText>
                @EnrollmentTable(abandoned)
            }
        }
    </MudTabPanel>

    @* ===== Attendance Tab ===== *@
    <MudTabPanel Text="@translator["CycleAttendance"]" Icon="@Icons.Material.Filled.CheckCircle">
        @if (DetailsState.Value.IsLoadingAttendance)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (DetailsState.Value.Attendance.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@translator["NoSessions"]</MudAlert>
        }
        else
        {
            @foreach (var session in DetailsState.Value.Attendance)
            {
                <MudPaper Outlined="true" Class="pa-3 ma-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">
                            @session.SessionDate.ToString("d")
                            @if (!string.IsNullOrEmpty(session.SessionTopic))
                            {
                                <span> — @session.SessionTopic</span>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@session.Attendees.Count(attendee => attendee.Attended)</MudChip>
                                <span>/</span>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@session.Attendees.Count</MudChip>
                            }
                        </MudText>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="@(() => SaveAttendance(session))">
                            @translator["Save"]
                        </MudButton>
                    </MudStack>
                    <MudStack Spacing="1">
                        @foreach (var attendee in session.Attendees)
                        {
                            <MudCheckBox T="bool"
                                         Value="@attendee.Attended"
                                         ValueChanged="@(v => attendee.Attended = v)"
                                         Label="@attendee.DiscipleName"
                                         ReadOnly="@attendee.IsAbandoned"
                                         Disabled="@attendee.IsAbandoned"
                                         Dense="true" />
                        }
                    </MudStack>
                </MudPaper>
            }
        }
    </MudTabPanel>

    @* ===== Staff Tab ===== *@
    <MudTabPanel Text="@translator["Staff"]" Icon="@Icons.Material.Filled.SupervisedUserCircle">
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAddStaffDialog">
                @translator["AddStaff"]
            </MudButton>
        </MudStack>

        @if (DetailsState.Value.IsLoadingStaff)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (DetailsState.Value.Staff.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@translator["NoStaff"]</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>@translator["Name"]</th>
                        <th>@translator["Role"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in DetailsState.Value.Staff)
                    {
                        <tr>
                            <td>@staff.PersonName</td>
                            <td>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(staff.Role == CycleStaffRole.Coordinator ? Color.Primary : Color.Info)">
                                    @(staff.Role == CycleStaffRole.Coordinator ? translator["Coordinator"] : translator["Guide"])
                                </MudChip>
                            </td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => RemoveStaff(staff.Id))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    @* ===== Sessions Tab ===== *@
    <MudTabPanel Text="@translator["Sessions"]" Icon="@Icons.Material.Filled.Event">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudDatePicker @bind-Date="_newSessionDate" Label="@translator["Date"]" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_newSessionTopic" Label="@translator["Topic"]" Variant="Variant.Outlined" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSession"
                       Disabled="@(_newSessionDate is null)">
                @translator["AddSession"]
            </MudButton>
        </MudStack>

        @if (DetailsState.Value.Sessions.Count > 0)
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>@translator["Date"]</th>
                        <th>@translator["Topic"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in DetailsState.Value.Sessions)
                    {
                        <tr>
                            <td>@session.Date.ToString("d")</td>
                            <td>@(session.Topic ?? "—")</td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteSession(session.Id))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">@translator["NoSessions"]</MudAlert>
        }
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public int CycleId { get; set; }

    int MinAttendance => CyclesState.Value.Cycles.FirstOrDefault(c => c.Id == CycleId)?.MinAttendanceRequired ?? 0;

    DateTime? _newSessionDate;
    string? _newSessionTopic;

    RenderFragment EnrollmentTable(IList<CycleEnrollmentDto> enrollments) => __builder =>
    {
        <MudSimpleTable Dense="true" Hover="false" Striped="false">
            <thead>
                <tr>
                    <th>@translator["Name"]</th>
                    <th>@translator["Guide"]</th>
                    <th>@translator["Status"]</th>
                    <th>@translator["CycleAttendance"]</th>
                    <th>@translator["Enrolled"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in enrollments)
                {
                    <tr>
                        <td>@enrollment.DiscipleName</td>
                        <td>
                            <MudSelect T="int?" Value="@enrollment.CycleStaffId"
                                       ValueChanged="@(v => AssignGuide(enrollment, v))"
                                       Margin="Margin.Dense" Dense="true" Variant="Variant.Text">
                                <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                                @foreach (var staff in DetailsState.Value.Staff)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)staff.Id)">@staff.PersonName</MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                        <td>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@GetStatusColor(enrollment.Status)">
                                @GetStatusLabel(enrollment.Status)
                            </MudChip>
                        </td>
                        <td>@enrollment.AttendanceCount</td>
                        <td>@enrollment.EnrolledAt.ToString("d")</td>
                        <td>
                            @if (enrollment.Status == StepStatus.Enrolled)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Disabled="@(MinAttendance > 0 && enrollment.AttendanceCount < MinAttendance)"
                                               title="@translator["MarkCompleted"]"
                                               OnClick="@(() => MarkCompleted(enrollment))" />
                            }
                            @if (enrollment.Status == StepStatus.InPrayers)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.HowToReg"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               title="@translator["Enrolled"]"
                                               OnClick="@(() => MarkEnrolled(enrollment))" />
                            }
                            @if (enrollment.Status is StepStatus.Enrolled or StepStatus.InPrayers)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.PersonOff"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               title="@translator["MarkAbandoned"]"
                                               OnClick="@(() => MarkAbandoned(enrollment))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };

    Color GetStatusColor(StepStatus status) => status switch
    {
        StepStatus.Enrolled => Color.Success,
        StepStatus.InPrayers => Color.Info,
        StepStatus.Completed => Color.Default,
        StepStatus.Abandoned => Color.Error,
        _ => Color.Default
    };

    string GetStatusLabel(StepStatus status) => status switch
    {
        StepStatus.Enrolled => translator["Enrolled"],
        StepStatus.InPrayers => translator["InPrayers"],
        StepStatus.Completed => translator["Completed"],
        StepStatus.Abandoned => translator["Abandoned"],
        _ => status.ToString()
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new SetTitleAction { Title = translator["Details"] });
        Dispatcher.Dispatch(new FetchCycleDetailsAction { CycleId = CycleId });
        Dispatcher.Dispatch(new FetchCycleSessionsAction { CycleId = CycleId });
        Dispatcher.Dispatch(new FetchCycleAttendanceAction { CycleId = CycleId });
        Dispatcher.Dispatch(new FetchCycleStaffAction { CycleId = CycleId });
    }

    void MarkEnrolled(CycleEnrollmentDto enrollment)
    {
        Dispatcher.Dispatch(new UpdateEnrollmentStatusAction
        {
            CycleId = CycleId,
            EnrollmentId = enrollment.Id,
            Dto = new UpdateEnrollmentStatusDto { Status = StepStatus.Enrolled }
        });
    }

    void MarkAbandoned(CycleEnrollmentDto enrollment)
    {
        Dispatcher.Dispatch(new UpdateEnrollmentStatusAction
        {
            CycleId = CycleId,
            EnrollmentId = enrollment.Id,
            Dto = new UpdateEnrollmentStatusDto { Status = StepStatus.Abandoned }
        });
    }

    void SaveAttendance(CycleAttendanceDto session)
    {
        var attendedIds = session.Attendees
            .Where(a => a.Attended)
            .Select(a => a.DiscipleId)
            .ToList();

        Dispatcher.Dispatch(new RecordCycleAttendanceAction
        {
            CycleId = CycleId,
            SessionId = session.SessionId,
            Dto = new RecordCycleAttendanceDto { DiscipleIds = attendedIds }
        });
    }

    void AddSession()
    {
        if (_newSessionDate is null) return;

        Dispatcher.Dispatch(new CreateCycleSessionAction
        {
            CycleId = CycleId,
            Dto = new CreateCycleSessionDto
            {
                Date = DateOnly.FromDateTime(_newSessionDate.Value),
                Topic = _newSessionTopic
            }
        });

        _newSessionDate = null;
        _newSessionTopic = null;
    }

    void DeleteSession(int sessionId)
    {
        Dispatcher.Dispatch(new DeleteCycleSessionAction
        {
            CycleId = CycleId,
            SessionId = sessionId
        });
    }

    async Task OpenAddStaffDialog()
    {
        var dialog = await DialogService.ShowAsync<AddCycleStaffDialog>(translator["AddStaff"]);
        var result = await dialog.GetReturnValueAsync<AddCycleStaffDialog.AddCycleStaffResult>();

        if (result is null || result.SelectedUsers.Count == 0) return;

        foreach (var user in result.SelectedUsers)
        {
            Dispatcher.Dispatch(new AddCycleStaffAction
            {
                CycleId = CycleId,
                Dto = new CreateCycleStaffDto
                {
                    PersonId = user.Document,
                    Role = result.Role
                }
            });
        }
    }

    void AssignGuide(CycleEnrollmentDto enrollment, int? staffId)
    {
        if (staffId is null || staffId == enrollment.CycleStaffId) return;

        Dispatcher.Dispatch(new AssignGuideAction
        {
            CycleId = CycleId,
            Dto = new AssignGuideDto
            {
                CycleStaffId = staffId.Value,
                EnrollmentIds = [enrollment.Id]
            }
        });
    }

    void MarkCompleted(CycleEnrollmentDto enrollment)
    {
        Dispatcher.Dispatch(new UpdateEnrollmentStatusAction
        {
            CycleId = CycleId,
            EnrollmentId = enrollment.Id,
            Dto = new UpdateEnrollmentStatusDto { Status = StepStatus.Completed }
        });
    }

    void CloseCycle()
    {
        var cycle = CyclesState.Value.Cycles.FirstOrDefault(c => c.Id == CycleId);
        if (cycle is null) return;

        Dispatcher.Dispatch(new UpdateStepCycleAction
        {
            StepId = cycle.DiscipleStepId,
            CycleId = CycleId,
            Dto = new UpdateStepCycleDto
            {
                Name = cycle.Name,
                StartDate = cycle.StartDate,
                EndDate = cycle.EndDate,
                MinAttendanceRequired = cycle.MinAttendanceRequired,
                IsOpen = false,
                EnrollmentDeadline = cycle.EnrollmentDeadline
            }
        });
    }

    void RemoveStaff(int staffId)
    {
        Dispatcher.Dispatch(new RemoveCycleStaffAction
        {
            CycleId = CycleId,
            StaffId = staffId
        });
    }
}
