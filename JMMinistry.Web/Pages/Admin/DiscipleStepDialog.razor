@using Fluxor
@using JMMinistry.Common.Dtos.DiscipleJourney
@using JMMinistry.Common.Dtos.DiscipleJourney.Enums
@using JMMinistry.Web.Store.DiscipleStepsUseCase

@inject IStringLocalizer<UIStrings> translator
@inject IState<DiscipleStepsState> StepsState

<Dialog ResultType="CreateDiscipleStepDto"
        Result="Model"
        Color="Color.Primary"
        PrimaryText="@(IsEditMode ? translator["Save"] : translator["Create"])">
    <Content>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="Model.Name"
                          Label="@translator["Name"]"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="Model.Description"
                          Label="@translator["Description"]"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Lines="3" />

            <MudSelect T="StepCategory"
                       @bind-Value="Model.StepCategory"
                       Label="@translator["Category"]"
                       Required="true"
                       RequiredError="@translator["FieldRequired"]"
                       Variant="Variant.Outlined"
                       Disabled="_lockCategory">
                @foreach (var category in Enum.GetValues<StepCategory>())
                {
                    <MudSelectItem T="StepCategory" Value="category">@translator[category.ToString()]</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?"
                       Value="_selectedParentId"
                       ValueChanged="OnParentChanged"
                       Label="@translator["ParentStep"]"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       Disabled="_lockParent">
                @foreach (var step in StepsState.Value.Steps.Where(s => s.Id != ExistingStep?.Id))
                {
                    <MudSelectItem T="int?" Value="@((int?)step.Id)">@step.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="Model.RequiresCycle"
                       Label="@translator["RequiresCycle"]"
                       Color="Color.Primary"
                       Class="mt-2" />

            <MudSelect T="int"
                       Label="@translator["Requirements"]"
                       MultiSelection="true"
                       SelectedValues="_selectedRequirements"
                       SelectedValuesChanged="OnRequirementsChanged"
                       Variant="Variant.Outlined"
                       ToStringFunc="@(id => FindStepName(id))">
                @foreach (var step in AllSteps.Where(s => s.Id != ExistingStep?.Id))
                {
                    <MudSelectItem T="int" Value="step.Id">@step.Name</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </Content>
</Dialog>

@code {
    [Parameter]
    public DiscipleStepDto? ExistingStep { get; set; }

    [Parameter]
    public int? ParentStepId { get; set; }

    CreateDiscipleStepDto Model { get; set; } = new();

    MudForm? _form;

    IReadOnlyCollection<int> _selectedRequirements = [];
    int? _selectedParentId;
    bool _lockParent;
    bool _lockCategory;

    bool IsEditMode => ExistingStep is not null;

    IEnumerable<DiscipleStepDto> AllSteps =>
        StepsState.Value.Steps.SelectMany(s => new[] { s }.Concat(s.SubSteps));

    protected override void OnInitialized()
    {
        if (ExistingStep is not null)
        {
            Model.Name = ExistingStep.Name;
            Model.Description = ExistingStep.Description;
            Model.StepCategory = ExistingStep.StepCategory;
            Model.RequiresCycle = ExistingStep.RequiresCycle;
            Model.RequirementIds = ExistingStep.RequirementIds.ToList();
            Model.ParentStepId = ExistingStep.ParentStepId;
            _selectedRequirements = ExistingStep.RequirementIds.ToList();
            _selectedParentId = ExistingStep.ParentStepId;
        }
        else if (ParentStepId is not null)
        {
            _selectedParentId = ParentStepId;
            Model.ParentStepId = ParentStepId;
            _lockParent = true;

            var parent = StepsState.Value.Steps.FirstOrDefault(s => s.Id == ParentStepId);
            if (parent is not null)
            {
                Model.StepCategory = parent.StepCategory;
                _lockCategory = true;
            }
        }
    }

    void OnParentChanged(int? value)
    {
        _selectedParentId = value;
        Model.ParentStepId = value;

        if (value is not null)
        {
            var parent = StepsState.Value.Steps.FirstOrDefault(s => s.Id == value);
            if (parent is not null)
            {
                Model.StepCategory = parent.StepCategory;
                _lockCategory = true;
            }
        }
        else
        {
            _lockCategory = false;
        }
    }

    void OnRequirementsChanged(IEnumerable<int> values)
    {
        _selectedRequirements = values.ToList();
        Model.RequirementIds = values.ToList();
    }

    string FindStepName(int id) =>
        AllSteps.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString();
}
