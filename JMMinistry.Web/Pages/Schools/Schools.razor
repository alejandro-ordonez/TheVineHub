@using JMMinistry.Common.Dtos.School
@using JMMinistry.Common.Models
@using JMMinistry.Web.Api

@inject ISchoolApi _api
@inject IStringLocalizer<UIStrings> _translator
@inject NavigationManager _navigator

@page "/schools"
@attribute [Authorize]

<Header Title="@_translator["Schools"]">
    <ActionMenu>
        <MudFab StartIcon="@Icons.Material.Filled.Add"
                Color="Color.Primary"
                Disabled="@EditorOpen"
                Size="Size.Small"
                OnClick="() => EditorOpen = !EditorOpen">
        </MudFab>
    </ActionMenu>
</Header>

<Popup Open="EditorOpen">
    <Content>
        <MudForm Model="SchoolToEdit" @ref="schoolForm" Validation="SchoolValidator.ValidateValue" ValidationDelay="3">
            <MudText Typo="Typo.h6">@(SchoolToEdit.Id != 0 ? _translator["Update", SchoolToEdit.Name] : _translator["CreateNew", _translator["School"]])</MudText>
            <MudDivider />


            <MudTextField @bind-Value="SchoolToEdit!.Name"
                          For="@(() => SchoolToEdit!.Name)"
                          Immediate="true"
                          Required="true"
                          RequiredError="@_translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@_translator["SchoolName"]"
                          InputType="InputType.Text" />

            <MudTextField @bind-Value="SchoolToEdit!.Description"
                          For="@(() => SchoolToEdit!.Description)"
                          Immediate="true"
                          Required="true"
                          RequiredError="@_translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@_translator["Description"]"
                          InputType="InputType.Text" />


            <MudDivider />
            <MudButton OnClick="SaveSchool" Disabled="!schoolForm?.IsValid ?? true" Class="ml-auto mr-n3 mb-1" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Save">@_translator["Save"]</MudButton>
            <MudButton OnClick="Cancel" Class="ml-auto mr-n3 mb-1" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Save">@_translator["Cancel"]</MudButton>
        </MudForm>

    </Content>
</Popup>


<div class="dynamic-grid">

    @foreach(var school in SchoolList)
    {
        <CardComponent ModelType="int" CardModel="school" BasePath="/Schools" OnEdit="EditSchool"/>
    }

</div>


@code {
    IEnumerable<SchoolDto> SchoolList { get; set; } = [];

    [SupplyParameterFromForm]
    SchoolDto SchoolToEdit { get; set; } = new SchoolDto();

    bool EditorOpen { get; set; } = false;

    SchoolDtoValidator SchoolValidator { get; set; } = new SchoolDtoValidator();

    MudForm? schoolForm;

    [Inject]
    ISnackbar? SnackBar { get; set; }


    protected override async Task OnInitializedAsync()
    {
        SchoolList = (await _api.GetSchools())?.Data ?? [];
    }

    void EditSchool(CardModel<int> school)
    {
        SchoolToEdit = (SchoolDto)school;
        EditorOpen = true;
    }

    void Cancel()
    {
        EditorOpen = false;
        SchoolToEdit = new SchoolDto();
    }

    async Task SaveSchool()
    {
        schoolForm?.Validate();

        if (!schoolForm?.IsValid ?? false)
        {
            SnackBar?.Add(_translator["VerifyYourInputs"], Severity.Error);
            return;
        }

        if (SchoolToEdit.Id == default)
            await _api.CreateSchool(SchoolToEdit);
        else
            await _api.UpdateSchool(SchoolToEdit);

        SchoolList = (await _api.GetSchools())?.Data ?? [];
        EditorOpen = false;
    }
}
