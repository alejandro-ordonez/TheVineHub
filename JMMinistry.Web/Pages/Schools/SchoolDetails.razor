
@inject NavigationManager _navigator
@inject ISchoolApi _api 
@inject IStringLocalizer<UIStrings> _translator

@page "/schools/{schoolId:int}"
@using JMMinistry.Common.Dtos.School
@using JMMinistry.Web.Api

@if (!LoadSuccess)
{
    <div>@_translator["FailedToLoadResource"]</div>
}

else
{
    <HeaderPage Title="@School?.Name" SubTitle="@School?.Description">
        <ActionMenu>
            <MudFab StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary"
                    Disabled="@EditorOpen"
                    Size="Size.Small"
                    OnClick="() => EditorOpen = !EditorOpen">
            </MudFab>
        </ActionMenu>
    </HeaderPage>

    <div class="dynamic-grid">
        @foreach(var classDto in School?.Classes ?? [])
        {
            <CardComponent BasePath="/class" CardModel="classDto" ModelType="int"/>
        }
    </div>
}


@code {
    private bool EditorOpen { get; set; } = false;


    [Parameter]
    public int? SchoolId { get; set; }

    private SchoolWithClassesDto? School { get; set; }

    private bool LoadSuccess { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if(SchoolId == null)
        {
            _navigator.NavigateTo("/");
            return;
        }

        var response = await _api.GetSchool(SchoolId.Value);
        LoadSuccess = response?.Success ?? false;
        School = response?.Data;
    }
}
