@using JMMinistry.Common.Dtos.Gained
@using JMMinistry.Common.Dtos.Gained.Enums
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Web.Api
@using JMMinistry.Web.Pages.User
@attribute [Route(Routes.Gained)]
@attribute [Authorize]

@layout MainLayout

@inject IStringLocalizer<UIStrings> translator;
@inject IDialogService dialogService;
@inject IGainedUsersApi gainedUserApi;

<MudPaper Class="ma-2" >
    <Header Title="@translator["Gained"]">
        <ActionMenu>
            <MudFab StartIcon="@Icons.Material.Filled.Add"
                    Color="Color.Primary"
                    Disabled="@IsBusy"
                    Size="Size.Small"
                    OnClick="() => OpenAddGainedUser()">
            </MudFab>
        </ActionMenu>
    </Header>
</MudPaper>

<MudPaper Class="ma-2">

    <div class="users-grid" style="padding: 1rem;">
        @foreach (var gained in GainedUsers)
        {
            <UserCard User="gained" />
        }
    </div>

</MudPaper>

@code {
    bool IsBusy = false;

    IList<GainedUser> GainedUsers { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await gainedUserApi.GetGainedUsers();

        if (result is not null && result.Success && result.Data is not null)
        {
            GainedUsers = result.Data;
        }
    }


    async Task OpenAddGainedUser()
    {
        IsBusy = true;

        var dialog = await dialogService.ShowAsync<AddGainedDialog>(translator["GainedPerson"]);
        var result = await dialog.GetReturnValueAsync<DialogResult<CreateGainedUser>>();

        if (result is null || result.Data is null)
        {
            IsBusy = false;
            return;
        }

        await AddGainedUser(result.Data);

        IsBusy = false;
    }


    async Task AddGainedUser(CreateGainedUser user)
    {
        var result = await gainedUserApi.RegisterGainedPerson(user);

        if(result is not null && result.Success && result.Data is not null)
        {
            GainedUsers.Add(result.Data);
        }
    }

}
