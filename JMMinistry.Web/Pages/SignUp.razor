@page "/Signup"
@layout EmptyLayout

@using JMMinistry.Common.Dtos.User
@using JMMinistry.Common.Dtos.User.Enums;

@inject IStringLocalizer<UIStrings> _translator;

<div class="page-container">
    <section class="column side-section">
    </section>

    <section class="column content-section">

        <MudForm>
            <MudPaper Class="flex-grow-1">
                <MudStepper Vertical="false" ShowResetButton>

                    <MudStep Title="@_translator["BasicInformation"]">

                        <MudTextField @bind-Value="UserInfo.Name"
                                      For="@(() => UserInfo.Name)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Name"]"
                                      InputType="InputType.Text" />

                        <MudTextField @bind-Value="UserInfo.LastName"
                                      For="@(() => UserInfo.LastName)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["LastName"]"
                                      InputType="InputType.Text" />

                        <MudTextField @bind-Value="UserInfo.Birthday"
                                      For="@(() => UserInfo.Birthday)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Birthday"]"
                                      Converter="DateOnlyConverter"
                                      InputType="InputType.Date" />


                        <MudSelect @bind-Value="UserInfo.Gender"
                                   Label="@_translator[nameof(Gender)]"
                                   Placeholder="@_translator["SelectAnOption"]"
                                   Required="true"
                                   RequiredError="@_translator["FieldRequired"]"
                                   Variant="Variant.Outlined">
                            <MudSelectItem Value="Gender.Male">@_translator[Gender.Male.ToString()]</MudSelectItem>
                            <MudSelectItem Value="Gender.Female">@_translator[Gender.Female.ToString()]</MudSelectItem>
                        </MudSelect>

                        <MudSelect @bind-Value="UserInfo.MaritalStatus"
                                   Label="@_translator[nameof(MaritalStatus)]"
                                   Placeholder="@_translator["SelectAnOption"]"
                                   Required="true"
                                   RequiredError="@_translator["FieldRequired"]"
                                   Variant="Variant.Outlined">

                            @foreach (var maritalStatus in Enum.GetNames<MaritalStatus>())
                            {
                                <MudSelectItem Value="Gender.Male">@_translator[maritalStatus]</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect @bind-Value="UserInfo.EducationalLevel"
                                   Label="@_translator[nameof(EducationalLevel)]"
                                   Placeholder="@_translator["SelectAnOption"]"
                                   Required="true"
                                   RequiredError="@_translator["FieldRequired"]"
                                   Variant="Variant.Outlined">

                            @foreach (var level in Enum.GetNames<EducationalLevel>())
                            {
                                <MudSelectItem Value="Gender.Male">@_translator[level]</MudSelectItem>
                            }
                        </MudSelect>


                        <MudTextField @bind-Value="UserInfo.Profession"
                                      For="@(() => UserInfo.Profession)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Profession"]"
                                      InputType="InputType.Text" />


                        <MudTextField @bind-Value="UserInfo.Occupation"
                                      For="@(() => UserInfo.Occupation)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Occupation"]"
                                      InputType="InputType.Text" />
                    </MudStep>

                    <MudStep Title="@_translator["AddressInformation"]">

                        <MudTextField @bind-Value="UserInfo.Email"
                                      For="@(() => UserInfo.Email)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Email"]"
                                      InputType="InputType.Email" />

                        <MudTextField @bind-Value="UserInfo.Phone"
                                      For="@(() => UserInfo.Phone)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Phone"]"
                                      InputType="InputType.Telephone" />

                        <MudTextField @bind-Value="UserInfo.City"
                                      For="@(() => UserInfo.City)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["City"]"
                                      InputType="InputType.Text" />

                        <MudTextField @bind-Value="UserInfo.Locality"
                                      For="@(() => UserInfo.Locality)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Locality"]"
                                      InputType="InputType.Text" />

                        <MudTextField @bind-Value="UserInfo.Neighborhood"
                                      For="@(() => UserInfo.Neighborhood)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Neighborhood"]"
                                      InputType="InputType.Text" />

                        <MudTextField @bind-Value="UserInfo.Address"
                                      For="@(() => UserInfo.Address)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Address"]"
                                      InputType="InputType.Text" />


                    </MudStep>
                    <MudStep Title="@_translator["Credentials"]">
                        <MudTextField @bind-Value="UserInfo.Document"
                                      For="@(() => UserInfo.Document)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Document"]"
                                      InputType="InputType.Number" />

                        <MudTextField @bind-Value="UserInfo.Password"
                                      For="@(() => UserInfo.Password)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Password"]"
                                      InputType="InputType.Number" />

                        <MudTextField @bind-Value="UserInfo.Email"
                                      For="@(() => UserInfo.Email)"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="@_translator["FieldRequired"]"
                                      Variant="Variant.Outlined"
                                      Label="@_translator["Email"]"
                                      InputType="InputType.Number" />
                    </MudStep>
                </MudStepper>
            </MudPaper>
        </MudForm>
    </section>




</div>


@code {

    [SupplyParameterFromForm]
    CreateUserInfoDto UserInfo { get; set; } = new();

    MudBlazor.Converter<DateOnly> DateOnlyConverter = new Converter<DateOnly>
    {
        SetFunc = value => value.ToShortDateString(),
        GetFunc = text => DateOnly.Parse(text ?? "")
    };
}
