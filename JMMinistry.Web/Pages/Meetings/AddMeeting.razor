@using JMMinistry.Common.Dtos.Meetings
@using JMMinistry.Web.Extensions
@using JMMinistry.Web.Shared.Converters

@inject IStringLocalizer<UIStrings> translator;


<Dialog Result="Meeting"
        Color="Color.Primary"
        PrimaryText="@translator["Add"]">

    <Content>

        <MudForm Model="Meeting" @ref="cellForm">

            <MudTextField @bind-Value="Meeting.Name"
                          For="@(() => Meeting.Name)"
                          Immediate="true"
                          DebounceInterval="300"
                          Required="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Name"]"
                          InputType="InputType.Text" />

            <MudTextField @bind-Value="Meeting.Start"
                          For="@(() => Meeting.Start)"
                          Immediate="true"
                          DebounceInterval="300"
                          Required="true"
                          OnlyValidateIfDirty="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["Start"]"
                          Converter="timeOnlyConverter"
                          InputType="InputType.Time" />

            <MudTextField @bind-Value="Meeting.End"
                          For="@(() => Meeting.End)"
                          Immediate="true"
                          DebounceInterval="300"
                          Required="true"
                          OnlyValidateIfDirty="true"
                          RequiredError="@translator["FieldRequired"]"
                          Variant="Variant.Outlined"
                          Label="@translator["End"]"
                          Converter="timeOnlyConverter"
                          InputType="InputType.Time" />


            <MudCheckBox @bind-Value="Meeting.IsRecurrent"
                         For="@(() => Meeting.IsRecurrent)"
                         Label="@translator["IsRecurrent"]"/>

            @if (Meeting.IsRecurrent)
            {
                <MudSelect @bind-Value="Meeting.DayOfWeek"
                           Label="@translator["Day"]"
                           Placeholder="@translator["SelectDay"]"
                           Required="Meeting.IsRecurrent"
                           RequiredError="@translator["FieldRequired"]"
                           Variant="Variant.Outlined">

                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                    {
                        <MudSelectItem T="DayOfWeek?" Value="day">@translator[day.ToString()]</MudSelectItem>
                    }
                </MudSelect>
            }

            else
            {
                <MudTextField @bind-Value="Meeting.Date"
                              For="@(() => Meeting.Date)"
                              Immediate="true"
                              DebounceInterval="300"
                              Required="!Meeting.IsRecurrent"
                              OnlyValidateIfDirty="true"
                              RequiredError="@translator["FieldRequired"]"
                              Variant="Variant.Outlined"
                              Label="@translator["Date"]"
                              Converter="dateOnlyConverter"
                              InputType="InputType.Date" />
            }

        </MudForm>

    </Content>
</Dialog>

@code {

    MudForm? cellForm;
    readonly DateOnlyConverter dateOnlyConverter = new DateOnlyConverter();
    readonly TimeOnlyConverter timeOnlyConverter = new TimeOnlyConverter();

    [SupplyParameterFromForm]
    public CreateMeetingDto Meeting { get; set; } = new();
}
