<MudOverlay @bind-Visible="Open" DarkBackground="true" AutoClose="false" />

<MudPopover Open="@Open" Fixed="true" Class="px-4 pt-4 w-50" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter" Elevation="4">
    <div class="d-flex flex-column p-5 popup-container">
        @Content
    </div>

    <div class="action-container">
        @Actions
    </div>
</MudPopover>


@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
