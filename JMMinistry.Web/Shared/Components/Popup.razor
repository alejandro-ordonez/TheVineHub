<MudOverlay @bind-Visible="Open" DarkBackground="true" AutoClose="true" />

<MudPopover Open="@Open" Fixed="true" Class="popup px-4 pt-4" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter" Elevation="4">
    <div class="d-flex flex-column">
        @Content
    </div>
</MudPopover>


@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public RenderFragment? Content { get; set; }
}
