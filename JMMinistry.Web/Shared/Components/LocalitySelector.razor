@using JMMinistry.Common.Dtos.Common

@inject IStringLocalizer<UIStrings> translator;

@inherits MudAutocomplete<LocalityDto>;

@code {

    [Parameter]
    public CityDto? City { get; set; }

    [Inject]
    IStringLocalizer<UIStrings>? Translator { get; set; }

    protected override Task OnInitializedAsync()
    {
        SearchFunc = Search;
        Variant = Variant.Outlined;
        Label = Translator?["Locality"] ?? "";
        ToStringFunc = (city) => city?.Name;
        ShowProgressIndicator = true;

        StateHasChanged();
        return Task.CompletedTask;
    }

    Task<IEnumerable<LocalityDto>>? Search(string? searchTerm, CancellationToken cancellationToken)
    {
        var localities = City?.Localities ?? [];
        return Task.FromResult(localities.Where(locality => locality.Name.Contains(searchTerm)));
    }
}
