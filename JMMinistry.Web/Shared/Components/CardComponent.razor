@using JMMinistry.Common.Models

@typeparam ModelType where ModelType: IConvertible

@inject NavigationManager _navigator
@inject IStringLocalizer<UIStrings> _translator

<MudCard>
    <MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.h3">@CardModel?.Name</MudText>
        </MudCardContent>
    </MudCardHeader>

    <MudCard>
        <MudCardMedia Image="images/door.jpg" Height="200" />
        <MudCardContent>
            <MudText Typo="Typo.body2">@CardModel?.Description</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Send" OnClick="@(() => OpenModel())">@_translator["Manage"]</MudButton>
            @if(OnEdit.HasDelegate)
            {
                <MudButton Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OnEdit.InvokeAsync(CardModel))"></MudButton>
            }
        </MudCardActions>
    </MudCard>

</MudCard>

@code {

    [Parameter]
    public required CardModel<ModelType> CardModel { get; set; }

    [Parameter]
    public required string BasePath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<CardModel<ModelType>> OnEdit { get; set; }

    void OpenModel()
    {
        if (string.IsNullOrEmpty(BasePath))
            throw new ArgumentException("The Base path is required");

        if (CardModel == null)
            throw new ArgumentException("The model needs to be set");

        _navigator.NavigateTo($"{BasePath}/{CardModel.Id}");
    }
}
