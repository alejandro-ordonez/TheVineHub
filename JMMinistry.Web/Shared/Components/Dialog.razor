@inject IStringLocalizer<UIStrings> _translator;

@typeparam ResultType where ResultType : class;

<MudDialog>
    <DialogContent>
        @Content
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@_translator[CancelText ?? "Cancel"]</MudButton>

        @if (SecondaryButton)
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SecondaryAction">@_translator[SecondaryText ?? ""]</MudButton>
        }

        @if (PrimaryButton)
        {
            <MudButton Color="@Color" Disabled="@(!IsFormValid ?? false)" Variant="Variant.Filled" OnClick="Submit">@_translator[PrimaryText ?? ""]</MudButton>
        }
    </DialogActions>
</MudDialog>


@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth =  true,
                MaxWidth = MaxWidth
            };

            await MudDialog.SetOptionsAsync(options);
        }
    }

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public MaxWidth MaxWidth { get; set; } = MaxWidth.Large;

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public bool PrimaryButton { get; set; } = true;

    [Parameter]
    public string? PrimaryText { get; set; }

    [Parameter]
    public bool SecondaryButton { get; set; } = false;

    [Parameter]
    public string? SecondaryText { get; set; }

    [Parameter]
    public string? CancelText { get; set; } = "Cancel";

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public required ResultType Result { get; set; }

    [Parameter]
    public bool? IsFormValid { get; set; } = true;

    private void Submit() => MudDialog?.Close(new DialogResult<ResultType>
    {
        Option = DialogResultOption.PrimaryButton,
        Data = Result
    });

    private void SecondaryAction() => MudDialog?.Close(new DialogResult<ResultType>
    {
        Option = DialogResultOption.SecondaryButton,
        Data = Result
    });

    private void Cancel() => MudDialog?.Cancel();
}