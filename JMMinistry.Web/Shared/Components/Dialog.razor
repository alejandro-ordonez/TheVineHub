@inject IStringLocalizer<UIStrings> _translator;

@typeparam ResultType;

<MudDialog >
    <DialogContent>
        @Content
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@_translator["Cancel"]</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>


@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth =  true,
                MaxWidth = MaxWidth.Large
            };

            await MudDialog.SetOptionsAsync(options);
        }
    }

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public string? ButtonText { get; set; }

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public required ResultType Result { get; set; }

    private void Submit() => MudDialog?.Close(DialogResult.Ok<ResultType>(Result));

    private void Cancel() => MudDialog?.Cancel();
}