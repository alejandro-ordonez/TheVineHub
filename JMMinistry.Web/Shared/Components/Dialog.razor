@inject IStringLocalizer<UIStrings> _translator;

@typeparam ResultType;

<MudDialog >
    <DialogContent>
        @Content
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@_translator[SecondaryText ?? "Cancel"]</MudButton>
        @if (PrimaryButton)
        {
            <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@PrimaryText</MudButton>
        }
    </DialogActions>
</MudDialog>


@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(MudDialog is not null)
        {
            var options = MudDialog.Options with
            {
                FullWidth =  true,
                MaxWidth = MaxWidth
            };

            await MudDialog.SetOptionsAsync(options);
        }
    }

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public MaxWidth MaxWidth { get; set; } = MaxWidth.Large;

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public bool PrimaryButton { get; set; } = true;

    [Parameter]
    public string? PrimaryText { get; set; }

    [Parameter]
    public string? SecondaryText { get; set; } = "Cancel";

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public required ResultType Result { get; set; }

    private void Submit() => MudDialog?.Close(DialogResult.Ok<ResultType>(Result));

    private void Cancel() => MudDialog?.Cancel();
}