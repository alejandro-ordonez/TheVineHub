@using JMMinistry.Web.Pages
@using JMMinistry.Web.Services

@inject IStringLocalizer<UIStrings> _translator


<MudNavMenu>
    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" Href="/">
        @_translator["Home"]
    </MudNavLink>

    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" Href="@Routes.Ministry">
        @_translator["MyMinistry"]
    </MudNavLink>

    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Add" Href="@Routes.Gained">
        @_translator["GainedUsers"]
    </MudNavLink>

    <AuthorizeView Roles="Admin">
        <MudDivider Style="margin: 1rem 0"/>
        <MudText Class="mud-nav-link mud-ripple align-items-center" Typo="Typo.subtitle2">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" style="margin: 0 20px"/> 
            @_translator["Administration"]  </MudText>

        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.VerifiedUser" Href="@Routes.UserManagement">@_translator["Users"]</MudNavLink>
    </AuthorizeView>

</MudNavMenu>

@code {
    protected override Task OnInitializedAsync()
    {
        
        return base.OnInitializedAsync();
    }
}
