@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.DiscipleJourney.Enums
@using JMMinistry.Web.Pages
@using JMMinistry.Web.Services
@using JMMinistry.Web.Store.DiscipleStepsUseCase
@using JMMinistry.Web.Store.DiscipleStepsUseCase.Actions

@inherits FluxorComponent

@inject IStringLocalizer<UIStrings> _translator
@inject IState<DiscipleStepsState> DiscipleStepsState
@inject IDispatcher Dispatcher


<MudNavMenu>
    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" Href="/">
        @_translator["Home"]
    </MudNavLink>

    <MudNavGroup Title="@_translator["MyMinistry"]" Icon="@Icons.Material.Filled.People" Expanded="true">
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group"
                    Href="@Routes.Ministry">@_translator["Cells"]</MudNavLink>
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Check"
                    Href="@Routes.MeetingAttendances">@_translator["Attendances"]</MudNavLink>

        @foreach (var step in DiscipleStepsState.Value.Steps)
        {
            @if (step.SubSteps.Count > 0)
            {
                <MudNavGroup Title="@step.Name" Icon="@GetStepIcon(step.StepCategory)">
                    @foreach (var subStep in step.SubSteps)
                    {
                        <MudNavLink Match="NavLinkMatch.All"
                                    Icon="@GetStepIcon(subStep.StepCategory)"
                                    Href="@($"{Routes.DiscipleStep}/{subStep.Id}")">
                            @subStep.Name
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Match="NavLinkMatch.All"
                            Icon="@GetStepIcon(step.StepCategory)"
                            Href="@($"{Routes.DiscipleStep}/{step.Id}")">
                    @step.Name
                </MudNavLink>
            }
        }
    </MudNavGroup>

    <AuthorizeView Roles="Admin">
        <MudDivider Style="margin: 1rem 0"/>

        <MudNavGroup Title="@_translator["Administration"]" Icon="@Icons.Material.Filled.AdminPanelSettings">
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.VerifiedUser" Href="@Routes.UserManagement">@_translator["Users"]</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Schedule" Href="@Routes.Meetings">@_translator["Meetings"]</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Route" Href="@Routes.DiscipleStepsAdmin">@_translator["DiscipleSteps"]</MudNavLink>
        </MudNavGroup>

     </AuthorizeView>

</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchDiscipleStepsAction());
    }

    private static string GetStepIcon(StepCategory category) => category switch
    {
        StepCategory.Gain => Icons.Material.Filled.PersonAdd,
        StepCategory.Consolidate => Icons.Material.Filled.Handshake,
        StepCategory.Disciple => Icons.Material.Filled.School,
        StepCategory.Send => Icons.Material.Filled.Send,
        _ => Icons.Material.Filled.Circle
    };
}
