@using JMMinistry.Web.Services

@inject IStringLocalizer<UIStrings> _translator
@inject IAuthService authService


<MudNavMenu>
    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" Href="/">
        @_translator["Home"]
    </MudNavLink>

    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" Href="/ministry">
        @_translator["MyMinistry"]
    </MudNavLink>

    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person" Href="/profile">@_translator["Profile"]</MudNavLink>

    <AuthorizeView Roles="Admin">
        <MudDivider />
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings">@_translator["Administration"]</MudIcon>  </MudText>

        <MudNavLink Match="NavLinkMatch.All" Href="/users">@_translator["Users"]</MudNavLink>
    </AuthorizeView>

    <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="() => authService.LogOut()">
        @_translator["Logout"]
    </MudNavLink>

</MudNavMenu>

@code {
    protected override Task OnInitializedAsync()
    {
        
        return base.OnInitializedAsync();
    }
}
