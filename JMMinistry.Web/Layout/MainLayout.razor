@using Fluxor
@using Fluxor.Blazor.Web.Components
@using JMMinistry.Common.Dtos.User
@using JMMinistry.Common
@using JMMinistry.Web.Api
@using JMMinistry.Web.Extensions
@using JMMinistry.Web.Pages
@using JMMinistry.Web.Services
@using JMMinistry.Web.Store.PageUseCase

@inherits FluxorLayout

@inject IStringLocalizer<UIStrings> translator;
@inject IUserApi userApi;
@inject IAuthService authService;
@inject IAuthStateProvider authStateProvider;
@inject NavigationManager navigationManager;

<MudThemeProvider IsDarkMode="true"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">

        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />

        <MudSpacer />
            
        <MudText Typo="Typo.h6">@State.Value.Title</MudText>

        <MudSpacer />

        <div>
            <MudAvatar Class="avatar-icon" Color="Color.Secondary" onclick="@(() =>ToggleUserPopoverOpen())">
                @if (string.IsNullOrEmpty(User?.Photo))
                {
                    @User?.Name[0]
                }

                else
                {
                    <MudImage Src="@User.Photo"></MudImage>
                }
            </MudAvatar>

            <MudPopover Open="_userPopoverOpen">
                <MudNavLink Icon="@Icons.Material.Filled.Person" Href="@Routes.User">@User?.GetFirsNameAndLastName()</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Settings" Href="@Routes.Settings">@translator["Settings"]</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="() => authService.LogOut()">
                    @translator["Logout"]
                </MudNavLink>
            </MudPopover>

        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudDrawerHeader>
            <MudImage Fluid="true" Src="/images/JMLogo.png" />
        </MudDrawerHeader>

        <NavMenu></NavMenu>

    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{

    [Inject]
    public required IState<PageState> State { get; set; }


    private bool _open = true;
    bool _userPopoverOpen = false;

    PartialUserInfoDto? User;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var result = await userApi.GetUserInfo();

        if(result is not null && result.Success)
        {
            User = result.Data;
            StateHasChanged();
        }
    }

    public string PageTitle { get; set; } = string.Empty;

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private void ToggleUserPopoverOpen()
    {
        _userPopoverOpen = !_userPopoverOpen;
    }
}
