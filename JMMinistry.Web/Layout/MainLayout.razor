@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">

        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">@PageTitle</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit"/>
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudDrawerHeader>
            <img src="/images/WebHeaderIcon.svg" />
        </MudDrawerHeader>

        <NavMenu></NavMenu>

    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="mt-6">
            <CascadingValue Value="PageTitle">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code{
    private bool _open = true;

    private string _test = string.Empty;

    public string PageTitle { 
        get => _test; 
        set => _test = value; 
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
